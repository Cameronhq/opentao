---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { subnets, getSubnet, type Subnet } from '../../../data/subnets';
import { getRichSubnet, type RichSubnet } from '../../../data/subnet-rich';

export async function getStaticPaths() {
  return subnets.map((s) => ({ params: { slug: s.slug }, props: { subnet: s } }));
}

interface Props { subnet: Subnet }
const { subnet } = Astro.props;
const rich: RichSubnet | undefined = getRichSubnet(subnet.slug);

const related = subnets.filter((s) => s.cat === subnet.cat && s.slug !== subnet.slug).slice(0, 4);
---
<BaseLayout
  title={rich ? `Subnet ${subnet.netuid} · ${subnet.name} — OpenTAO` : `Subnet ${subnet.netuid} · ${subnet.name} — OpenTAO`}
  description={rich?.shortPitch ?? subnet.description}
  section="beginner"
>
  {rich ? (
    <>
      <!-- ════════════════════════════════════════════════════════ HERO -->
      <header class="hero-full">
        <div class="max-w-[1400px] mx-auto px-6 pt-12">
          <div class="hero-bcrumb">
            <a href="/">OpenTAO</a><span class="sep">/</span>
            <a href="/beginner/subnets">Subnets</a><span class="sep">/</span>
            <span class="curr">{subnet.netuid} · {subnet.name}</span>
          </div>
          <div class="hero-meta">
            <span class={`cat cat-${subnet.cat}`}>{subnet.catLabel}</span>
            <span class="light"><span class="dot"></span>active · <span data-live="miners" data-fallback={subnet.miners}>{subnet.miners}</span> miners · <span data-live="validators" data-fallback={subnet.validators}>{subnet.validators}</span> validators</span>
          </div>
          <div class="hero-id"><span class="lbl">netuid</span><span class="num">{subnet.netuid}</span></div>
          <h1>{subnet.name}</h1>
          <p class="pitch" set:html={rich.shortPitch}></p>
          <button class="ask-agent" data-ask={`Use the OpenTAO MCP to evaluate and help me start mining subnet ${subnet.netuid} (${subnet.name}). My hardware is: `}>◆ Ask your agent about SN{subnet.netuid} <span class="aa-hint">copy prompt</span></button>

          <div class="stats-row">
            <div class="stat-cell"><div class="k">Emission · 24h</div><div class="v"><span data-live="emission" data-fallback={subnet.emission}>{subnet.emission}</span></div></div>
            <div class="stat-cell"><div class="k">Burn-cost</div><div class="v"><span data-live="burn-cost">—</span></div></div>
            <div class="stat-cell"><div class="k">α-price</div><div class="v">{subnet.price} τ</div><div class="sub">mcap {subnet.mcap}</div></div>
            <div class="stat-cell"><div class="k">Active miners</div><div class="v"><span data-live="miners" data-fallback={subnet.miners}>{subnet.miners}</span></div></div>
            <div class="stat-cell"><div class="k">Registered</div><div class="v stat-v-small">{subnet.registered}</div></div>
          </div>
          <span class="live-badge"><span class="pulse"></span>Live · via taostats · refreshed daily</span>
        </div>
      </header>

      <!-- ════════════════════════════════════════════════════════ BODY: 2-col main + sticky sidebar -->
      <div class="max-w-[1400px] mx-auto px-6 py-12">
        <div class="body-grid">
          <div class="body-main">

            <section id="overview">
              <h2 class="section-h">Overview</h2>
              <div class="prose">
                {rich.overview.map((p, i) => (
                  <p class={i === 0 ? 'lead' : ''} set:html={p}></p>
                ))}
              </div>
            </section>

            <section id="cycle">
              <div class="cycle-head">
                <h2 class="section-h-inline">One tempo · miner ↔ validator</h2>
                <span class="tempo">1 tempo ≈ 72 min · ~20×/day</span>
              </div>
              <div class="stage-row">
                {(['challenge', 'compute', 'score', 'settle'] as const).map((key) => {
                  const stage = rich.cycle[key];
                  const sideClass = stage.actor === 'Miner' ? 'miner' : stage.actor === 'Validator' ? 'validator' : 'chain';
                  const stepLabels = { challenge: '01 · Challenge', compute: '02 · Compute', score: '03 · Score', settle: '04 · Settle' } as const;
                  return (
                    <div class="stage" data-side={sideClass}>
                      <div class="step">{stepLabels[key]}</div>
                      <div class="actor">{stage.actor}</div>
                      <h3>{stage.title}</h3>
                      <p>{stage.body}</p>
                      <div class="data"><span class="k">{stage.dataK} </span><span class="v">{stage.dataV}</span></div>
                    </div>
                  );
                })}
              </div>
            </section>

            <section id="roles">
              <h2 class="section-h">Who does what</h2>
              <div class="roles-grid">
                <div class="role-card" data-role="miner">
                  <div class="role-head"><span class="role-dot"></span><span class="role-name">MINER</span></div>
                  <h3>Produces the work.</h3>
                  <div class="field"><span class="k">does</span><span class="v">{rich.miner.does}</span></div>
                  <div class="field"><span class="k">input</span><span class="v">{rich.miner.input}</span></div>
                  <div class="field"><span class="k">output</span><span class="v">{rich.miner.output}</span></div>
                  <div class="field"><span class="k">hardware</span><span class="v">{rich.miner.hardware}</span></div>
                  <div class="field"><span class="k">paid for</span><span class="v">{rich.miner.paidFor}</span></div>
                  <div class="field"><span class="k">paid via</span><span class="v">{rich.miner.paidVia}</span></div>
                </div>
                <div class="role-card" data-role="validator">
                  <div class="role-head"><span class="role-dot"></span><span class="role-name">VALIDATOR</span></div>
                  <h3>Grades against truth.</h3>
                  <div class="field"><span class="k">does</span><span class="v">{rich.validator.does}</span></div>
                  <div class="field"><span class="k">requires</span><span class="v">{rich.validator.requires}</span></div>
                  <div class="field"><span class="k">output</span><span class="v">{rich.validator.output}</span></div>
                  <div class="field"><span class="k">paid for</span><span class="v">{rich.validator.paidFor}</span></div>
                  <div class="field"><span class="k">paid via</span><span class="v">{rich.validator.paidVia}</span></div>
                </div>
              </div>
            </section>

            <section id="scoring">
              <h2 class="section-h">How scoring works</h2>
              <div class="prose">
                <p class="lead">{rich.scoring.leadOneLine}</p>
                {rich.scoring.explanation.map((p) => <p>{p}</p>)}
              </div>
              <div class="callout-red">
                <div class="lbl">⚠ What doesn't work</div>
                <p>{rich.scoring.cheatPath}</p>
              </div>
            </section>

            <section id="customer">
              <h2 class="section-h">Who pays — and what they're paying for</h2>
              <div class="prose">
                <p class="lead">{rich.customer.leadOneLine}</p>
                {rich.customer.explanation.map((p) => <p>{p}</p>)}
              </div>

              <div class="compete-head">
                <h3>Competitive landscape</h3>
                <span class="scope">{rich.competitive.scope}</span>
              </div>
              <table class="compete-table">
                <thead><tr><th>Forecaster</th><th>Approach</th><th>Access</th><th>Differentiator</th></tr></thead>
                <tbody>
                  {rich.competitive.rows.map((row) => (
                    <tr class={row.isSelf ? 'self' : ''}>
                      <td>{row.name}{row.subtitle && <span class="badge decn">{row.subtitle}</span>}</td>
                      <td>{row.approach}</td>
                      <td><span class={`badge ${row.accessTone}`}>{row.access}</span></td>
                      <td>{row.differentiator}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <p class="compete-note">{rich.competitive.note}</p>
            </section>

            <section id="team">
              <h2 class="section-h">Team &amp; founders {rich.team.placeholder && <span class="ph-badge">⚠ placeholder data</span>}</h2>
              <div class="team-intro">
                {rich.team.intro.map((p) => <p>{p}</p>)}
              </div>
              <div class="founders-grid">
                {rich.team.founders.map((f) => (
                  <div class="founder" data-c={f.gradient}>
                    <div class="top">
                      <div class="avatar">{f.initials}</div>
                      <div><div class="name">{f.name}</div><div class="role">{f.role}</div></div>
                    </div>
                    <p class="bio">{f.bio}</p>
                    {(f.twitter || f.github) && (
                      <div class="socials">
                        {f.twitter && <a href={f.twitter} target="_blank" rel="noopener">𝕏</a>}
                        {f.github  && <a href={f.github}  target="_blank" rel="noopener">github</a>}
                      </div>
                    )}
                  </div>
                ))}
              </div>
              <div class="team-meta">
                <div class="cell"><div class="k">Team size</div><div class="v">{rich.team.size}</div></div>
                <div class="cell"><div class="k">Founded</div><div class="v">{rich.team.founded}</div></div>
                <div class="cell"><div class="k">Based</div><div class="v">{rich.team.based}</div></div>
              </div>
              <div class="backers-row">
                <span class="lbl">Backers / funding</span>
                <span class="v"><em>{rich.team.backers}</em></span>
              </div>
              {rich.team.placeholder && (
                <div class="ph-banner">⚠ Some founder data above is placeholder. When the operator claims this page (or a contributor verifies via PR), real values replace these.</div>
              )}
            </section>

            <section id="history">
              <h2 class="section-h">Project history</h2>
              <div class="timeline">
                {rich.milestones.map((m) => (
                  <div class="milestone"><span class="mdate">{m.date}</span><span class="mtext">{m.text}</span></div>
                ))}
              </div>
            </section>

            <section id="join">
              <h2 class="section-h">Joining</h2>
              <div class="join-card">
                <div>
                  <div class="lbl">→ become a miner</div>
                  <h3>{rich.join.title}</h3>
                  <p>{rich.join.body}</p>
                  <div class="aside-note">{rich.join.asideNote}</div>
                </div>
                <a class="cta" href={`/mine/playbooks/${subnet.slug}`}>
                  Open mining playbook
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
                </a>
              </div>
            </section>
          </div>

          <aside class="body-side">
            <div class="side-card">
              <div class="lbl">Quick facts</div>
              <div class="row"><span class="k">netuid</span><span class="v">{subnet.netuid}</span></div>
              <div class="row"><span class="k">operator</span><span class="v">{rich.team.founders[0]?.name.includes('[') ? subnet.owner.slice(0, 18) : rich.team.intro[0].split(' ').slice(0, 2).join(' ')}</span></div>
              <div class="row"><span class="k">registered</span><span class="v">{subnet.registered}</span></div>
            </div>

            <div class="side-card">
              <div class="lbl">Tags</div>
              <div class="tag-list">
                {rich.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
            </div>

            <div class="side-card">
              <div class="lbl">External</div>
              <div class="ext-list">
                {rich.external.github  && <a href={rich.external.github}  target="_blank" rel="noopener"><span>GitHub</span><span class="arrow">↗</span></a>}
                {rich.external.website && <a href={rich.external.website} target="_blank" rel="noopener"><span>Website</span><span class="arrow">↗</span></a>}
                {rich.external.twitter && <a href={rich.external.twitter} target="_blank" rel="noopener"><span>Twitter</span><span class="arrow">↗</span></a>}
                <a href={rich.external.taostats} target="_blank" rel="noopener"><span>taostats</span><span class="arrow">↗</span></a>
              </div>
            </div>

            {rich.tweets && rich.tweets.length > 0 && (
              <div class="side-card">
                <div class="lbl">Operator feed</div>
                <div class="tw-mini">
                  {rich.tweets.slice(0, 3).map((t) => (
                    <div class="item">
                      <div class="when">{t.when}</div>
                      {t.body}
                    </div>
                  ))}
                </div>
                {rich.external.twitter && <div class="more"><a href={rich.external.twitter} target="_blank" rel="noopener">view full feed ↗</a></div>}
              </div>
            )}
          </aside>
        </div>
      </div>

      <!-- ════════════════════════════════════════════════════════ RELATED -->
      <section class="related">
        <div class="max-w-[1400px] mx-auto px-6">
          <h2 class="section-h">Related subnets · same category</h2>
          <div class="related-grid">
            {related.map((r) => (
              <a href={`/beginner/subnets/${r.slug}`} class="related-card">
                <div class="top"><span class="net">{r.netuid}</span><span class={`cat-tag cat-${r.cat}`}>{r.catLabel}</span></div>
                <div class="name">{r.name}</div>
                <div class="desc">{r.description}</div>
              </a>
            ))}
          </div>
        </div>
      </section>

      <footer class="pg-footer">
        <div class="max-w-[1400px] mx-auto px-6">
          <div class="row">
            <div style="display: flex; gap: 22px;">
              <a href={`https://github.com/opentao-ai/opentao/blob/main/src/data/subnets/${subnet.slug}.ts`} target="_blank" rel="noopener">Edit on GitHub ↗</a>
              <a href="#">Claim this subnet</a>
            </div>
            <span>Live data refreshes daily via taostats</span>
          </div>
        </div>
      </footer>

      <script define:vars={{ netuid: subnet.netuid }}>
        async function refreshLive() {
          try {
            const r = await fetch(`/api/subnet/${netuid}`, { headers: { accept: 'application/json' } });
            if (!r.ok) return;
            const d = await r.json();
            const set = (k, v) => document.querySelectorAll(`[data-live="${k}"]`).forEach((el) => { el.textContent = String(v); });
            if (d.burn_cost_tao  != null) set('burn-cost', d.burn_cost_tao.toFixed(2) + ' τ');
            if (d.miner_count    != null) set('miners',    d.miner_count);
            if (d.validator_count!= null) set('validators',d.validator_count);
          } catch (err) { console.warn('[subnet] live data unavailable:', err); }
        }
        refreshLive();
      </script>
    </>
  ) : (
    /* ──────────────────────────────────── Lightweight stub fallback ────── */
    <>
      <section class="border-b hairline">
        <div class="max-w-[1400px] mx-auto px-6 pt-12 pb-10">
          <div class="hero-bcrumb">
            <a href="/">OpenTAO</a><span class="sep">/</span>
            <a href="/beginner/subnets">Subnets</a><span class="sep">/</span>
            <span class="curr">{subnet.netuid} · {subnet.name}</span>
          </div>
          <div class="flex items-end justify-between gap-8 flex-wrap mb-10">
            <div>
              <div class="flex items-center gap-3 mb-4 flex-wrap">
                <span class={`cat cat-${subnet.cat}`}>{subnet.catLabel}</span>
                <span class="text-xs font-mono text-[color:var(--color-fg-dim)]"><span class="dot mr-1"></span>active · owner: {subnet.owner}</span>
              </div>
              <div class="flex items-baseline gap-5 mb-3">
                <span class="font-mono text-[color:var(--color-fg-dim)] text-sm">netuid</span>
                <span class="font-mono text-[64px] leading-none font-semibold tracking-tight">{subnet.netuid}</span>
              </div>
              <h1 class="font-serif text-[44px] font-medium leading-tight tracking-[-0.015em]">{subnet.name}</h1>
              <p class="text-[color:var(--color-fg-muted)] mt-3 text-lg max-w-[640px]">{subnet.description}</p>
              <button class="ask-agent" data-ask={`Use the OpenTAO MCP to evaluate and help me start mining subnet ${subnet.netuid} (${subnet.name}). My hardware is: `}>◆ Ask your agent about SN{subnet.netuid} <span class="aa-hint">copy prompt</span></button>
            </div>
          </div>
          <div class="stub-banner">
            <div class="label">Lightweight page</div>
            <p class="text-sm text-[color:var(--color-fg-muted)] leading-relaxed m-0">
              This subnet doesn't have a full write-up yet. The on-chain stats below are live; the rest is being authored.
              For an example of the fully-built template, see <a class="inline" href="/beginner/subnets/18-zeus" style="color: #b8470b">SN18 Zeus</a>.
              <a class="inline" href="https://github.com/opentao-ai/opentao/blob/main/src/data/subnets/" target="_blank" rel="noopener" style="color: #b8470b">Help write this page →</a>
            </p>
          </div>
          <div class="grid grid-cols-2 md:grid-cols-6 border hairline rounded-md overflow-hidden bg-[color:var(--color-surface)] mt-8">
            <div class="stub-stat"><div class="section-label">Emission · 24h</div><div class="stub-stat-num">{subnet.emission}</div></div>
            <div class="stub-stat"><div class="section-label">Market cap</div><div class="stub-stat-num">{subnet.mcap}</div></div>
            <div class="stub-stat"><div class="section-label">α-price (τ)</div><div class="stub-stat-num">{subnet.price}</div></div>
            <div class="stub-stat"><div class="section-label">Miners</div><div class="stub-stat-num">{subnet.miners}</div></div>
            <div class="stub-stat"><div class="section-label">Validators</div><div class="stub-stat-num">{subnet.validators}</div></div>
            <div class="stub-stat"><div class="section-label">Registered</div><div class="stub-stat-num text-base">{subnet.registered}</div></div>
          </div>
        </div>
      </section>

      <section class="border-b hairline">
        <div class="max-w-[1400px] mx-auto px-6 py-14">
          <div class="section-label mb-6">More from the directory</div>
          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
            <a href="/beginner/subnets/18-zeus" class="card rounded-md p-5">
              <div class="flex items-baseline justify-between mb-3"><span class="font-mono text-2xl font-semibold">18</span><span class="cat cat-data">Data</span></div>
              <div class="font-medium mb-1">Zeus ★</div>
              <p class="text-xs text-[color:var(--color-fg-muted)] leading-relaxed">Fully-built reference page.</p>
            </a>
            {related.slice(0, 3).map((r) => (
              <a href={`/beginner/subnets/${r.slug}`} class="card rounded-md p-5">
                <div class="flex items-baseline justify-between mb-3"><span class="font-mono text-2xl font-semibold">{r.netuid}</span><span class={`cat cat-${r.cat}`}>{r.catLabel}</span></div>
                <div class="font-medium mb-1">{r.name}</div>
                <p class="text-xs text-[color:var(--color-fg-muted)] leading-relaxed line-clamp-2">{r.description}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    </>
  )}

  <script>
    // "Ask your agent" — copy a ready-to-paste prompt that targets the OpenTAO MCP.
    document.querySelectorAll<HTMLButtonElement>('.ask-agent').forEach((btn) => {
      const hint = btn.querySelector('.aa-hint');
      const original = hint?.textContent || 'copy prompt';
      btn.addEventListener('click', async () => {
        const prompt = btn.getAttribute('data-ask') || '';
        try {
          await navigator.clipboard.writeText(prompt);
          if (hint) { hint.textContent = 'copied ✓'; setTimeout(() => { hint.textContent = original; }, 1400); }
        } catch {}
      });
    });
  </script>
</BaseLayout>

<style>
  .ask-agent { display: inline-flex; align-items: center; gap: 10px; margin-top: 22px; padding: 9px 16px; border-radius: 8px; border: 1px solid rgba(184,71,11,0.35); background: rgba(184,71,11,0.06); color: #b8470b; font-size: 14px; font-weight: 500; cursor: pointer; transition: all .12s; }
  .ask-agent:hover { background: rgba(184,71,11,0.1); border-color: rgba(184,71,11,0.55); }
  .ask-agent .aa-hint { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; color: #767680; }

  /* ──────────────────────────────────── HERO */
  .hero-full { padding-bottom: 48px; border-bottom: 1px solid var(--color-border, rgba(15,15,18,0.08)); }
  .hero-bcrumb { display: flex; gap: 6px; align-items: center; font-family: var(--font-mono); font-size: 11px; color: #767680; margin-bottom: 20px; }
  .hero-bcrumb a { color: #767680; text-decoration: none; }
  .hero-bcrumb a:hover { color: #0c0c10; }
  .hero-bcrumb .sep { opacity: 0.4; }
  .hero-bcrumb .curr { color: #0c0c10; }

  .hero-meta { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; margin-bottom: 18px; }
  .hero-meta .light { font-family: var(--font-mono); font-size: 11px; color: #767680; }
  .hero-meta .dot { width: 7px; height: 7px; border-radius: 999px; background: #15803d; box-shadow: 0 0 8px rgba(22,163,74,0.45); display: inline-block; vertical-align: middle; margin-right: 6px; }

  .hero-id { display: flex; align-items: baseline; gap: 18px; margin-bottom: 10px; }
  .hero-id .lbl { font-family: var(--font-mono); font-size: 12px; color: #767680; }
  .hero-id .num { font-family: var(--font-mono); font-size: 56px; font-weight: 600; letter-spacing: -0.02em; color: #0c0c10; line-height: 1; }
  h1 { font-family: var(--font-serif); font-weight: 500; font-size: 44px; letter-spacing: -0.015em; line-height: 1.1; margin: 6px 0 18px; }
  .pitch { font-family: var(--font-serif); font-style: italic; font-size: 22px; line-height: 1.45; color: #0c0c10; max-width: 760px; margin: 0; }
  .pitch strong { font-style: normal; font-weight: 500; color: #b8470b; }

  /* ──────────────────────────────────── STATS */
  .stats-row { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0; border: 1px solid rgba(15,15,18,0.08); border-radius: 10px; overflow: hidden; background: #fafaf9; margin-top: 28px; }
  @media (max-width: 1100px) { .stats-row { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 640px)  { .stats-row { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .stat-cell { padding: 16px 18px; border-right: 1px solid rgba(15,15,18,0.08); border-bottom: 1px solid rgba(15,15,18,0.08); background: #ffffff; }
  .stat-cell:last-child { border-right: 0; }
  .stat-cell .k { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: #767680; margin-bottom: 6px; }
  .stat-cell .v { font-family: var(--font-mono); font-weight: 600; font-size: 20px; color: #0c0c10; font-variant-numeric: tabular-nums; }
  .stat-cell .v.stat-v-small, .stat-cell .stat-v-small { font-size: 16px; }
  .stat-cell .sub { font-family: var(--font-mono); font-size: 10px; color: #767680; margin-top: 3px; }
