---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const tweets = [
  { author: 'Cortex', handle: '@cortex_ai', time: '2h', grad: 'linear-gradient(135deg, #b8470b, #a16207)', body: 'v3.2 ships in 30 min — verifier ensemble now includes Llama-405B as a grader. Curious to see how miners adapt.', link: 'github.com/cortex/v3.2-notes', stats: ['💬 24', '🔁 41', '❤️ 312', '📊 18.4K'] },
  { author: 'cortex / kelvin', handle: '@kelvin_cortex', time: '8h', grad: 'linear-gradient(135deg, #6741d9, #1c6ea4)', body: "Reading through this week's top traces… someone solved Problem #1147 with an approach we haven't seen in our training set. Wild. We're forwarding it to the eval team.", stats: ['💬 18', '🔁 26', '❤️ 184', '📊 9.2K'] },
  { author: 'Cortex', handle: '@cortex_ai', time: '1d', grad: 'linear-gradient(135deg, #b8470b, #a16207)', body: "We're hiring an ML engineer for the verifier ensemble team. Remote, anywhere — bias toward London / SG / SF time zones.", link: 'cortex.ai/jobs/ml-eng', stats: ['💬 42', '🔁 88', '❤️ 421', '📊 31.0K'] },
  { author: 'priya / cortex', handle: '@priya_cortex', time: '2d', grad: 'linear-gradient(135deg, #15803d, #1c6ea4)', body: "Open question we're chewing on: should we reward length quadratically, or penalize verbosity once a trace hits diminishing returns? Strong opinions welcome 🧵", stats: ['💬 67', '🔁 14', '❤️ 208', '📊 12.6K'] },
  { author: 'Cortex', handle: '@cortex_ai', time: '4d', grad: 'linear-gradient(135deg, #b8470b, #a16207)', body: 'Mainnet emissions up 34% over the last 30 days. Thanks to all the new miners. We crossed 1,000 active hotkeys this week — feels nuts to type that out. To the next thousand.', stats: ['💬 89', '🔁 124', '❤️ 1.2K', '📊 84.7K'], wide: true },
];

const related = [
  { netuid: 19, name: 'Vesper', body: 'Math olympiad-style problems with verified proofs.', href: '#' },
  { netuid: 68, name: 'Praxis', body: 'Multi-step planning for agent workflows.', href: '#' },
  { netuid: 91, name: 'Solace', body: 'Code-trace reasoning with sandbox verification.', href: '#' },
];
---
<BaseLayout
  title="Subnet 42 · Cortex — OpenTAO"
  description="An open marketplace for chains of thought. Open-ended reasoning traces graded by an ensemble of verifier models."
  section="beginner"
>
  <section class="border-b hairline">
    <div class="max-w-[1400px] mx-auto px-6 pt-12 pb-10">
      <div class="flex items-center gap-2 text-xs font-mono text-[color:var(--color-fg-dim)] mb-6 flex-wrap">
        <a href="/" class="hover:text-[color:var(--color-fg)]">OpenTAO</a><span>/</span>
        <a href="/beginner/subnets" class="hover:text-[color:var(--color-fg)]">Subnets</a><span>/</span>
        <span class="text-[color:var(--color-fg)]">42 · Cortex</span>
      </div>

      <div class="flex items-end justify-between gap-8 flex-wrap mb-10">
        <div>
          <div class="flex items-center gap-3 mb-4 flex-wrap">
            <span class="cat cat-reason">Reasoning</span>
            <span class="text-xs font-mono text-[color:var(--color-fg-dim)]"><span class="dot-active mr-1"></span>active</span>
            <span class="text-xs font-mono text-[color:var(--color-fg-dim)]">· owner: @cortex-team ✓ claimed</span>
          </div>
          <div class="flex items-baseline gap-5 mb-3">
            <span class="font-mono text-[color:var(--color-fg-dim)] text-sm">netuid</span>
            <span class="font-mono text-[64px] leading-none font-semibold tracking-tight">42</span>
          </div>
          <h1 class="text-[44px] font-semibold leading-tight tracking-[-0.02em]">Cortex</h1>
          <p class="text-[22px] font-medium text-[color:var(--color-fg)] mt-4 leading-[1.35] max-w-[640px]">An open marketplace for chains of thought.</p>
          <p class="text-[color:var(--color-fg-muted)] mt-3 text-base max-w-[640px]">Open-ended reasoning traces, graded by an ensemble of verifier models. Miners produce step-by-step solutions; validators score on correctness, faithfulness, and elegance.</p>
        </div>

        <div class="flex flex-col items-end gap-2">
          <a href="/mine/playbooks" class="inline-flex items-center gap-2 text-sm font-semibold px-5 py-3 rounded-md" style="background: #0c0c10; color: #ffffff;">
            Open mining playbook
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
          <span class="text-xs font-mono text-[color:var(--color-fg-dim)]">✓ verified 2d ago by @reza</span>
        </div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-6 border hairline rounded-md overflow-hidden bg-[color:var(--color-surface)]">
        <div class="stat-cell"><div class="section-label">Emission · 24h</div><div class="stat-num mt-1 tabular">412.18 <span class="text-[color:var(--color-fg-muted)] text-sm">τ</span></div></div>
        <div class="stat-cell"><div class="section-label">Market cap</div><div class="stat-num mt-1 tabular">$83.4M</div></div>
        <div class="stat-cell"><div class="section-label">Price (τ)</div><div class="stat-num mt-1 tabular">0.0721 <span style="color: #15803d" class="text-xs font-mono">+4.18%</span></div></div>
        <div class="stat-cell"><div class="section-label">Miners</div><div class="stat-num mt-1 tabular">1,184</div></div>
        <div class="stat-cell"><div class="section-label">Validators</div><div class="stat-num mt-1 tabular">64</div></div>
        <div class="stat-cell"><div class="section-label">Registered</div><div class="stat-num mt-1 tabular text-lg">2025·08·14</div></div>
      </div>
    </div>
  </section>

  <section class="border-b hairline">
    <div class="max-w-[1400px] mx-auto px-6 py-16 grid lg:grid-cols-[1fr_320px] gap-12">
      <div class="prose">
        <h2 id="what">What it does</h2>
        <p class="lead">Cortex pays miners to produce step-by-step reasoning traces for hard problems — math, code, logic puzzles, multi-hop inference. An ensemble of verifier models grades each trace on correctness, faithfulness, and elegance.</p>
        <p>Most reasoning data inside frontier labs is generated this way: humans (or models) producing chains of thought, then graders scoring them. Cortex turns this loop into an open market — any GPU operator can mine, any team can use the corpus.</p>

        <h2 id="why">Why it matters</h2>
        <ul>
          <li><strong>Reasoning is the bottleneck</strong> for autonomous agents. Better traces → better policies.</li>
          <li><strong>Closed-model reasoning data is the most valuable corpus in AI today</strong> — and the most gatekept. Cortex makes it open.</li>
          <li><strong>The scoring is the product.</strong> An ensemble grader trained on millions of traces is itself a valuable artifact, distilled back into the network.</li>
        </ul>

        <h2 id="mine">For miners</h2>
        <p>Cortex is a good first competitive subnet — single GPU is enough, the community is responsive, and the scoring is well-documented.</p>
        <ul>
          <li><strong>Hardware</strong>: 1 × A100 80G recommended. 1 × H100 also works. 4090 viable but tight on context.</li>
          <li><strong>Setup time</strong>: ~45 minutes after General Setup.</li>
          <li><strong>First emission</strong>: ~2 tempo (~2.5 hours) after registration.</li>
        </ul>
      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 lg:self-start">
        <div>
          <div class="section-label mb-3">Links</div>
          <div class="space-y-2">
            <a href="#" class="link-card">
              <span class="icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1-.02-1.96-3.2.69-3.87-1.54-3.87-1.54-.52-1.33-1.27-1.68-1.27-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.69 1.25 3.34.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.9 10.9 0 015.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.4-5.25 5.69.41.36.78 1.06.78 2.13 0 1.54-.01 2.78-.01 3.16 0 .31.21.68.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/></svg></span>
              <span class="text-sm flex-1"><span class="text-[color:var(--color-fg)] font-medium">GitHub</span><br><span class="text-xs font-mono text-[color:var(--color-fg-dim)]">cortex-team/cortex</span></span>
              <span class="text-[color:var(--color-fg-dim)]">↗</span>
            </a>
            <a href="#" class="link-card">
              <span class="icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10"/></svg></span>
              <span class="text-sm flex-1"><span class="text-[color:var(--color-fg)] font-medium">Discord</span><br><span class="text-xs font-mono text-[color:var(--color-fg-dim)]">discord.gg/cortex</span></span>
              <span class="text-[color:var(--color-fg-dim)]">↗</span>
            </a>
            <a href="https://x.com/cortex_ai" target="_blank" class="link-card">
              <span class="icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></span>
              <span class="text-sm flex-1"><span class="text-[color:var(--color-fg)] font-medium">X (Twitter)</span><br><span class="text-xs font-mono text-[color:var(--color-fg-dim)]">@cortex_ai</span></span>
              <span class="text-[color:var(--color-fg-dim)]">↗</span>
            </a>
            <a href="#" class="link-card">
              <span class="icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 010 20M12 2a15 15 0 000 20"/></svg></span>
              <span class="text-sm flex-1"><span class="text-[color:var(--color-fg)] font-medium">Website</span><br><span class="text-xs font-mono text-[color:var(--color-fg-dim)]">cortex.ai</span></span>
              <span class="text-[color:var(--color-fg-dim)]">↗</span>
            </a>
          </div>
        </div>

        <div>
          <div class="section-label mb-3">Team</div>
          <div class="card rounded-md p-4">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-9 h-9 rounded-full" style="background: linear-gradient(135deg, #b8470b, #a16207);"></div>
              <div><div class="text-sm text-[color:var(--color-fg)] font-medium">@cortex-team</div><div class="text-xs font-mono text-[color:var(--color-fg-dim)]">claimed ✓ · 3 maintainers</div></div>
            </div>
            <div class="text-xs text-[color:var(--color-fg-muted)] leading-relaxed">Built by a small team out of London + Singapore. Previously worked on reasoning evals at a frontier lab.</div>
          </div>
        </div>

        <div>
          <div class="section-label mb-3">Emission · 30d</div>
          <div class="chart-box">
            <svg width="100%" height="100" viewBox="0 0 280 100" preserveAspectRatio="none">
              <defs>
                <linearGradient id="emissionGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                  <stop offset="0%" stop-color="#b8470b" stop-opacity="0.2"/>
                  <stop offset="100%" stop-color="#b8470b" stop-opacity="0"/>
                </linearGradient>
              </defs>
              <path d="M0,80 L10,75 L20,72 L30,78 L40,65 L50,68 L60,60 L70,55 L80,58 L90,50 L100,48 L110,52 L120,45 L130,40 L140,42 L150,38 L160,35 L170,40 L180,32 L190,28 L200,30 L210,25 L220,22 L230,25 L240,18 L250,20 L260,15 L270,12 L280,10 L280,100 L0,100 Z" fill="url(#emissionGrad)"/>
              <path d="M0,80 L10,75 L20,72 L30,78 L40,65 L50,68 L60,60 L70,55 L80,58 L90,50 L100,48 L110,52 L120,45 L130,40 L140,42 L150,38 L160,35 L170,40 L180,32 L190,28 L200,30 L210,25 L220,22 L230,25 L240,18 L250,20 L260,15 L270,12 L280,10" fill="none" stroke="#b8470b" stroke-width="1.5"/>
            </svg>
            <div class="flex items-center justify-between mt-3 text-xs font-mono text-[color:var(--color-fg-dim)]">
              <span>30d ago</span><span class="text-[color:var(--color-fg)]">+34% growth</span><span>today</span>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="border-b hairline">
    <div class="max-w-[1400px] mx-auto px-6 py-16">
      <div class="flex items-end justify-between mb-8 flex-wrap gap-4">
        <div>
          <div class="section-label mb-2">From the team · live</div>
          <h2 class="font-semibold text-2xl tracking-tight">Latest from <a href="https://x.com/cortex_ai" target="_blank" class="text-[color:var(--color-accent)] hover:underline">@cortex_ai</a></h2>
          <p class="text-[color:var(--color-fg-muted)] mt-2 max-w-[600px] text-base">Auto-pulled from X. Founder commentary, releases, and the occasional shitpost. Refreshed every 15 minutes.</p>
        </div>
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-2 text-xs font-mono text-[color:var(--color-fg-dim)]">
            <span class="dot-active"></span>
            <span>last sync · 2 min ago</span>
          </div>
          <a href="https://x.com/cortex_ai" target="_blank" class="inline-flex items-center gap-2 text-sm font-medium px-4 py-2 rounded-md border hairline-strong hover:border-[color:var(--color-fg-muted)]">
            <svg class="x-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            Follow on X
          </a>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-3">
        {tweets.map((t) => (
          <a href="https://x.com/cortex_ai" target="_blank" class={`tweet ${t.wide ? 'md:col-span-2' : ''}`}>
            <div class="flex items-start gap-3">
              <div class="tweet-avatar" style={`background: ${t.grad};`}></div>
              <div class="flex-1 min-w-0">
                <div class="flex items-baseline gap-2 flex-wrap">
                  <span class="text-[color:var(--color-fg)] font-semibold text-[15px]">{t.author}</span>
                  <span class="text-[color:var(--color-fg-dim)] text-sm">{t.handle}</span>
                  <span class="text-[color:var(--color-fg-dim)] text-sm">·</span>
                  <span class="text-[color:var(--color-fg-dim)] text-sm">{t.time}</span>
                  <svg class="x-icon ml-auto" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                </div>
                <div class="tweet-body">{t.body} {t.link && <span class="tweet-link">{t.link}</span>}</div>
                <div class="tweet-meta">
                  {t.stats.map((s) => <span class="stat">{s}</span>)}
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-6 text-xs font-mono text-[color:var(--color-fg-dim)] text-center">
        Source: X API · cached server-side · auto-refresh every 15 min · <a href="#" class="hover:text-[color:var(--color-fg)] underline">how this works</a>
      </div>
    </div>
  </section>

  <section class="border-b hairline">
    <div class="max-w-[1400px] mx-auto px-6 py-14">
      <div class="section-label mb-6">Related · Reasoning category</div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
        {related.map((r) => (
          <a href={r.href} class="card rounded-md p-5">
            <div class="flex items-baseline justify-between mb-3"><span class="font-mono text-2xl font-semibold">{r.netuid}</span><span class="cat cat-reason">Reasoning</span></div>
            <div class="font-medium mb-1">{r.name}</div>
            <p class="text-xs text-[color:var(--color-fg-muted)] leading-relaxed">{r.body}</p>
          </a>
        ))}
        <a href="/beginner/subnets" class="card rounded-md p-5" style="border-style: dashed; background: transparent;">
          <div class="font-mono text-xs text-[color:var(--color-fg-dim)] mb-3">Browse all</div>
          <div class="font-medium mb-1 text-[color:var(--color-fg-muted)]">11 reasoning subnets →</div>
        </a>
      </div>
    </div>
  </section>

  <section class="border-b hairline">
    <div class="max-w-[1400px] mx-auto px-6 py-12">
      <div class="flex flex-wrap items-center justify-between gap-4 text-xs font-mono text-[color:var(--color-fg-dim)]">
        <div class="flex items-center gap-5">
          <a href="#" class="hover:text-[color:var(--color-fg)]">Edit on GitHub</a>
          <a href="#" class="hover:text-[color:var(--color-fg)]">Suggest an edit</a>
        </div>
        <span>Subnet page last updated 2026·05·25 by @cortex-team · chain data refreshed 3 min ago</span>
      </div>
      <div class="mt-6 text-center"><a href="/beginner/subnets" class="text-sm hover:text-[color:var(--color-accent)] text-[color:var(--color-fg-muted)]">← All 128 subnets</a></div>
    </div>
  </section>
</BaseLayout>

<style>
  .stat-cell { padding: 16px 20px; border-right: 1px solid rgba(15,15,18,0.07); }
  .stat-cell:last-child { border-right: 0; }
  .stat-num { font-weight: 600; letter-spacing: -0.01em; font-size: 22px; font-variant-numeric: tabular-nums; }

  .cat { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; padding: 3px 8px; border-radius: 3px; border: 1px solid; display: inline-block; }
  .cat-reason { color: #a16207; border-color: rgba(161,98,7,0.3); background: rgba(161,98,7,0.06); }

  .dot-active { width: 7px; height: 7px; border-radius: 999px; background: #16a34a; box-shadow: 0 0 8px rgba(22,163,74,0.4); display: inline-block; }

  .prose { max-width: 720px; }
  .prose p { color: #1c1c22; line-height: 1.75; margin: 16px 0; font-size: 17px; }
  .prose p.lead { font-size: 19px; color: #0c0c10; margin-top: 0; }
  .prose h2 { font-weight: 600; font-size: 22px; letter-spacing: -0.015em; margin: 40px 0 8px; color: #0c0c10; }
  .prose h2:first-child { margin-top: 0; }
  .prose ul { margin: 16px 0; padding-left: 22px; }
  .prose li { color: #1c1c22; line-height: 1.75; margin: 6px 0; font-size: 17px; }
  .prose li::marker { color: #b8b8be; }
  .prose strong { font-weight: 600; }

  .link-card { display: flex; align-items: center; gap: 12px; padding: 14px 16px; border: 1px solid rgba(15,15,18,0.08); border-radius: 6px; background: #ffffff; transition: all .15s; }
  .link-card:hover { border-color: rgba(15,15,18,0.22); background: #fafaf9; }
  .link-card .icon { width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; color: #767680; }

  .chart-box { background: #fafaf9; border: 1px solid rgba(15,15,18,0.08); border-radius: 8px; padding: 24px; }

  .tweet { background: #ffffff; border: 1px solid rgba(15,15,18,0.08); border-radius: 10px; padding: 18px 20px; transition: all .15s; cursor: pointer; display: block; }
  .tweet:hover { border-color: rgba(15,15,18,0.22); background: #fafaf9; }
  .tweet-avatar { width: 38px; height: 38px; border-radius: 999px; flex-shrink: 0; }
  .tweet-body { color: #1c1c22; font-size: 15px; line-height: 1.55; margin: 10px 0; }
  .tweet-body .tweet-link { color: #b8470b; }
  .tweet:hover .tweet-link { text-decoration: underline; }
  .tweet-meta { display: flex; align-items: center; gap: 16px; color: #767680; font-size: 12px; font-family: var(--font-mono); flex-wrap: wrap; }
  .tweet-meta .stat { display: inline-flex; align-items: center; gap: 4px; }
  .x-icon { width: 18px; height: 18px; flex-shrink: 0; opacity: 0.6; }

  .tabular { font-variant-numeric: tabular-nums; }
</style>
