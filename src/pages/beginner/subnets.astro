---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { subnets as allSubnets } from '../../data/subnets';

interface Row {
  netuid: number;
  slug: string;
  name: string;
  owner: string;
  cat: string; // class suffix: llm, vision, audio, robotics, data, reasoning(reason), compute, storage
  catLabel: string;
  emission: string;
  mcap: string;
  price: string;
  delta: string;
  deltaSign: 'pos' | 'neg';
  spark: string; // polyline points
  sparkColor: string;
  miners: string;
  validators: string;
  pb: string;
  pbClass: 'pb-yes' | 'pb-no' | 'pb-stale';
  dot: 'dot-active' | 'dot-new' | 'dot-stale';
  featured?: boolean;
  refBadge?: boolean;
  newTag?: boolean;
}

// 11 curated rich rows kept first with their sparkline + playbook status — these are the
// hand-tuned hero entries. Everything else is synthesized from src/data/subnets.ts below.
const richRows: Row[] = [
  { netuid: 42, slug: '42-cortex', name: 'Cortex', owner: '@cortex-team', cat: 'reason', catLabel: 'Reasoning', emission: '412.18', mcap: '$83.4M', price: '0.0721', delta: '+4.18%', deltaSign: 'pos', spark: '0,14 8,12 16,13 24,9 32,8 40,6 48,7 60,4', sparkColor: '#16a34a', miners: '1,184', validators: '64', pb: '✓ 2d', pbClass: 'pb-yes', dot: 'dot-active', featured: true, refBadge: true },
  { netuid: 1, slug: '1-apex', name: 'Apex', owner: '@apex-labs', cat: 'llm', catLabel: 'LLM', emission: '388.04', mcap: '$71.9M', price: '0.0640', delta: '+1.92%', deltaSign: 'pos', spark: '0,10 8,11 16,9 24,8 32,10 40,8 48,7 60,6', sparkColor: '#16a34a', miners: '2,408', validators: '61', pb: '✓ 5d', pbClass: 'pb-yes', dot: 'dot-active' },
  { netuid: 3, slug: '3-templar', name: 'Templar', owner: '@templar.io', cat: 'llm', catLabel: 'LLM', emission: '336.42', mcap: '$58.2M', price: '0.0524', delta: '+7.81%', deltaSign: 'pos', spark: '0,16 8,15 16,12 24,11 32,9 40,8 48,5 60,3', sparkColor: '#16a34a', miners: '3,108', validators: '58', pb: '✓ 1d', pbClass: 'pb-yes', dot: 'dot-active' },
  { netuid: 17, slug: '17-spectra', name: 'Spectra', owner: '@spectra-vision', cat: 'vision', catLabel: 'Vision', emission: '298.55', mcap: '$48.1M', price: '0.0481', delta: '−1.21%', deltaSign: 'neg', spark: '0,6 8,8 16,7 24,9 32,8 40,10 48,11 60,12', sparkColor: '#b91c1c', miners: '1,892', validators: '52', pb: '✓ 12d', pbClass: 'pb-yes', dot: 'dot-active' },
  { netuid: 5, slug: '5-lumen', name: 'Lumen', owner: '@lumen-research', cat: 'vision', catLabel: 'Vision', emission: '271.09', mcap: '$42.7M', price: '0.0418', delta: '+0.84%', deltaSign: 'pos', spark: '0,11 8,12 16,10 24,11 32,9 40,10 48,8 60,9', sparkColor: '#16a34a', miners: '1,484', validators: '49', pb: '✓ 3d', pbClass: 'pb-yes', dot: 'dot-active' },
  { netuid: 36, slug: '36-glyph', name: 'Glyph', owner: '@glyph-code', cat: 'llm', catLabel: 'LLM', emission: '241.66', mcap: '$38.0M', price: '0.0386', delta: '+3.04%', deltaSign: 'pos', spark: '0,12 8,10 16,11 24,9 32,8 40,7 48,8 60,5', sparkColor: '#16a34a', miners: '1,728', validators: '50', pb: '✓ 6d', pbClass: 'pb-yes', dot: 'dot-active' },
  { netuid: 12, slug: '12-echelon', name: 'Echelon', owner: '@echelon-team', cat: 'audio', catLabel: 'Audio', emission: '215.82', mcap: '$31.4M', price: '0.0322', delta: '+1.16%', deltaSign: 'pos', spark: '0,10 8,11 16,9 24,10 32,8 40,9 48,8 60,7', sparkColor: '#16a34a', miners: '912', validators: '44', pb: '✓ 8d', pbClass: 'pb-yes', dot: 'dot-active' },
  { netuid: 27, slug: '27-atlas', name: 'Atlas', owner: '@atlas-robotics', cat: 'robotics', catLabel: 'Robotics', emission: '172.41', mcap: '$22.9M', price: '0.0254', delta: '+5.62%', deltaSign: 'pos', spark: '0,14 8,12 16,11 24,10 32,9 40,7 48,6 60,4', sparkColor: '#16a34a', miners: '448', validators: '36', pb: '✓ 4d', pbClass: 'pb-yes', dot: 'dot-active' },
  { netuid: 31, slug: '31-orion', name: 'Orion', owner: '@orion-storage', cat: 'storage', catLabel: 'Storage', emission: '142.51', mcap: '$16.0M', price: '0.0182', delta: '+0.92%', deltaSign: 'pos', spark: '0,10 8,9 16,10 24,8 32,9 40,8 48,9 60,7', sparkColor: '#16a34a', miners: '1,386', validators: '38', pb: '✓ 9d', pbClass: 'pb-yes', dot: 'dot-active' },
  { netuid: 8, slug: '8-proteus', name: 'Proteus', owner: '@proteus-ai', cat: 'data', catLabel: 'Data', emission: '62.18', mcap: '$5.4M', price: '0.0066', delta: '−3.41%', deltaSign: 'neg', spark: '0,5 8,7 16,8 24,9 32,11 40,12 48,13 60,14', sparkColor: '#b91c1c', miners: '402', validators: '20', pb: '⚠ 73d', pbClass: 'pb-stale', dot: 'dot-stale' },
  { netuid: 57, slug: '57-helix', name: 'Helix', owner: '@helix-ai', cat: 'data', catLabel: 'Data', emission: '48.04', mcap: '$3.9M', price: '0.0048', delta: '+12.18%', deltaSign: 'pos', spark: '0,17 8,15 16,12 24,10 32,8 40,6 48,4 60,2', sparkColor: '#b8470b', miners: '184', validators: '16', pb: '— missing', pbClass: 'pb-no', dot: 'dot-new', newTag: true },
];

// Synthesize stub rows for the remaining 117 subnets from data/subnets.ts
const richNetuids = new Set(richRows.map((r) => r.netuid));
const stubRows: Row[] = allSubnets
  .filter((s) => !richNetuids.has(s.netuid))
  .map((s) => ({
    netuid: s.netuid,
    slug: s.slug,
    name: s.name,
    owner: s.owner,
    cat: s.cat,
    catLabel: s.catLabel,
    emission: s.emission,
    mcap: s.mcap,
    price: s.price,
    delta: s.delta,
    deltaSign: s.deltaSign,
    // Generic flat sparkline for stub rows — no real time series yet
    spark: '0,10 10,10 20,10 30,10 40,10 50,10 60,10',
    sparkColor: '#767680',
    miners: s.miners,
    validators: s.validators,
    pb: '— missing',
    pbClass: 'pb-no' as const,
    dot: 'dot-active' as const,
  }));

const rows: Row[] = [...richRows, ...stubRows];
---
<BaseLayout
  title="Subnet Directory — OpenTAO"
  description="128 live markets for intelligence. Click any subnet to read about what it does, who's mining it, and how to join."
  section="beginner"
>
  <section class="border-b hairline">
    <div class="max-w-[1500px] mx-auto px-6 pt-10 pb-6">
      <div class="flex items-end justify-between flex-wrap gap-6 mb-8">
        <div>
          <Breadcrumb crumbs={[
            { href: '/', label: 'OpenTAO' },
            { label: 'Subnet directory' },
          ]} />
          <h1 class="text-[40px] leading-[1.05] tracking-[-0.025em] font-semibold">Subnets</h1>
          <p class="text-[color:var(--color-fg-muted)] mt-2 max-w-[540px] text-sm">128 live markets for intelligence. Click any subnet to read about what it does, who's mining it, and how to join.</p>
        </div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-7 border hairline rounded-md overflow-hidden bg-[color:var(--color-surface)]">
        <div class="stat-cell"><div class="section-label">TAO price</div><div class="stat-num mt-1 tabular">$284.51 <span class="pos text-xs font-mono">+2.31%</span></div></div>
        <div class="stat-cell"><div class="section-label">Market cap</div><div class="stat-num mt-1 tabular">$2.41B</div></div>
        <div class="stat-cell"><div class="section-label">Total emission · 24h</div><div class="stat-num mt-1 tabular">7,200 τ</div></div>
        <div class="stat-cell"><div class="section-label">Active subnets</div><div class="stat-num mt-1 tabular">128</div></div>
        <div class="stat-cell"><div class="section-label">Active miners</div><div class="stat-num mt-1 tabular">52,184</div></div>
        <div class="stat-cell"><div class="section-label">Validators</div><div class="stat-num mt-1 tabular">1,248</div></div>
        <div class="stat-cell"><div class="section-label">Block</div><div class="stat-num mt-1 tabular">#4,920,118</div></div>
      </div>
    </div>
  </section>

  <section class="border-b hairline sticky top-[57px] z-40 nav-blur">
    <div class="max-w-[1500px] mx-auto px-6 py-3 flex flex-wrap items-center gap-3">
      <div class="flex items-center gap-2 px-3 py-2 border hairline rounded-md text-sm text-[color:var(--color-fg-muted)] w-full sm:w-64">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
        <input type="text" placeholder="Search by name, netuid, owner…" class="bg-transparent outline-none text-[color:var(--color-fg)] flex-1 placeholder:text-[color:var(--color-fg-dim)] text-sm" />
      </div>
      <div class="flex items-center gap-2 overflow-x-auto">
        <button class="pill active">All</button>
        <button class="pill">LLM</button>
        <button class="pill">Vision</button>
        <button class="pill">Audio</button>
        <button class="pill">Robotics</button>
        <button class="pill">Data</button>
        <button class="pill">Reasoning</button>
        <button class="pill">Compute</button>
        <button class="pill">Storage</button>
      </div>
      <div class="flex items-center gap-2 ml-auto">
        <button class="pill flex items-center gap-1.5"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3" fill="currentColor"/></svg>Active only</button>
        <button class="pill flex items-center gap-1.5"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22V8M5 11l7-7 7 7"/></svg>Has playbook</button>
      </div>
    </div>
  </section>

  <section class="border-b hairline">
    <div class="max-w-[1500px] mx-auto px-6 pt-6 pb-2">
      <div class="section-label mb-3">Featured · reference page</div>
      <a href="/beginner/subnets/42-cortex" class="featured-callout">
        <div class="flex items-center gap-6 flex-wrap">
          <div class="flex items-baseline gap-3 shrink-0">
            <span class="font-mono text-xs text-[color:var(--color-fg-dim)]">netuid</span>
            <span class="font-mono text-[40px] leading-none font-semibold tracking-tight" style="color: #b8470b">42</span>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-3 mb-1 flex-wrap">
              <h3 class="text-xl font-serif font-medium">Cortex</h3>
              <span class="cat cat-reason">Reasoning</span>
              <span class="ref-badge">★ full page</span>
              <span class="text-xs font-mono text-[color:var(--color-fg-dim)]">— the only completed subnet template</span>
            </div>
            <p class="text-sm text-[color:var(--color-fg-muted)]">Open-ended reasoning traces graded by an ensemble of verifier models. Has the full validator/miner network graph, Twitter feed, leaderboards, and all content sections.</p>
          </div>
          <div class="text-sm text-[color:var(--color-fg)] flex items-center gap-2 shrink-0">
            Open page <span class="arrow">→</span>
          </div>
        </div>
      </a>
    </div>
  </section>

  <section>
    <div class="max-w-[1500px] mx-auto px-6 py-8">
      <div class="overflow-x-auto">
        <table class="subnet-table tabular">
          <thead>
            <tr>
              <th class="left">#<span class="sort">↕</span></th>
              <th class="left">Subnet</th>
              <th class="left">Category</th>
              <th class="sorted">Emission · 24h <span class="sort">↓</span></th>
              <th>Market cap <span class="sort">↕</span></th>
              <th>Price (τ) <span class="sort">↕</span></th>
              <th>24h <span class="sort">↕</span></th>
              <th>7d trend</th>
              <th>Miners <span class="sort">↕</span></th>
              <th>Validators <span class="sort">↕</span></th>
              <th>Playbook</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr class={r.featured ? 'featured' : ''} data-href={`/beginner/subnets/${r.slug}`}>
                <td class="left"><span class="netuid">{r.netuid}</span></td>
                <td class="left">
                  <div class="name">
                    {r.name}
                    {r.refBadge && <span class="ref-badge">★ full page</span>}
                    {r.newTag && <span class="text-[9px] text-[color:var(--color-accent)] font-mono ml-1">NEW</span>}
                  </div>
                  <div class="owner">{r.owner}</div>
                </td>
                <td class="left"><span class={`cat cat-${r.cat}`}>{r.catLabel}</span></td>
                <td><span class="text-[color:var(--color-fg)]">{r.emission}</span> <span class="text-[color:var(--color-fg-dim)] text-xs">τ</span></td>
                <td>{r.mcap}</td>
                <td>{r.price}</td>
                <td class={r.deltaSign}>{r.delta}</td>
                <td>
                  <svg class="spark" width="60" height="20" viewBox="0 0 60 20">
                    <polyline fill="none" stroke={r.sparkColor} stroke-width="1.4" points={r.spark} />
                  </svg>
                </td>
                <td>{r.miners}</td>
                <td>{r.validators}</td>
                <td><span class={r.pbClass}>{r.pb}</span></td>
                <td><span class={r.dot}></span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t hairline pt-5">
        <div class="text-xs font-mono text-[color:var(--color-fg-dim)]" data-showing>Showing <span class="text-[color:var(--color-fg)]">1–{rows.length}</span> of <span class="text-[color:var(--color-fg)]">{rows.length}</span> subnets</div>

        <div class="text-xs font-mono text-[color:var(--color-fg-dim)]"><a href="#" class="hover:text-[color:var(--color-fg)] underline underline-offset-2">CSV ↓</a> · <a href="#" class="hover:text-[color:var(--color-fg)] underline underline-offset-2">methodology</a></div>
      </div>
    </div>
  </section>

  <script>
    document.querySelectorAll<HTMLTableRowElement>('tr[data-href]').forEach((tr) => {
      tr.style.cursor = 'pointer';
      tr.addEventListener('click', () => {
        const href = tr.getAttribute('data-href');
        if (href) window.location.href = href;
      });
    });
  </script>
</BaseLayout>

<style>
  .stat-cell { padding: 14px 18px; border-right: 1px solid rgba(15,15,18,0.07); }
  .stat-cell:last-child { border-right: 0; }
  .stat-num { font-weight: 600; letter-spacing: -0.01em; font-size: 18px; font-variant-numeric: tabular-nums; }

  .pill { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border: 1px solid rgba(15,15,18,0.12); border-radius: 6px; font-size: 13px; color: #4a4a52; background: transparent; white-space: nowrap; }
  .pill:hover { border-color: rgba(15,15,18,0.28); color: #0c0c10; }
  .pill.active { color: #b8470b; border-color: rgba(184,71,11,0.4); background: rgba(184,71,11,0.06); }

  table.subnet-table { width: 100%; border-collapse: collapse; }
  .subnet-table thead th { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: #767680; font-weight: 400; padding: 14px 12px; text-align: right; border-bottom: 1px solid rgba(15,15,18,0.12); white-space: nowrap; background: #ffffff; }
  .subnet-table thead th.left { text-align: left; }
  .subnet-table thead th .sort { opacity: 0.4; margin-left: 4px; }
  .subnet-table thead th.sorted .sort { opacity: 1; color: #b8470b; }
  .subnet-table thead th.sorted { color: #0c0c10; }
  .subnet-table tbody td { padding: 14px 12px; border-bottom: 1px solid rgba(15,15,18,0.05); font-size: 13px; text-align: right; vertical-align: middle; }
  .subnet-table tbody td.left { text-align: left; }
  .subnet-table tbody tr { transition: background .12s; }
  .subnet-table tbody tr:hover { background: #fafaf9; }
  .subnet-table tbody tr:hover .netuid { color: #b8470b; }
  .subnet-table tbody tr.featured td { background: rgba(184,71,11,0.05); }
  .subnet-table tbody tr.featured:hover td { background: rgba(184,71,11,0.09); }
  .subnet-table tbody tr.featured td:first-child { border-left: 3px solid #b8470b; }
  .subnet-table tbody tr.featured .netuid { color: #b8470b; font-weight: 600; }

  .featured-callout { background: linear-gradient(90deg, rgba(184,71,11,0.06), rgba(184,71,11,0.02), rgba(184,71,11,0)); border: 1px solid rgba(184,71,11,0.25); border-radius: 10px; padding: 22px 26px; transition: all .15s; display: block; }
  .featured-callout:hover { border-color: rgba(184,71,11,0.5); transform: translateY(-1px); }
  .featured-callout .arrow { transition: transform .15s; }
  .featured-callout:hover .arrow { transform: translateX(4px); }

  .netuid { font-family: var(--font-mono); font-weight: 500; transition: color .15s; color: #0c0c10; }
  .name { font-weight: 500; color: #0c0c10; }
  .owner { font-family: var(--font-mono); font-size: 11px; color: #767680; }

  .cat { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.08em; text-transform: uppercase; padding: 2px 6px; border-radius: 3px; border: 1px solid; display: inline-block; }
  .cat-llm      { color: #6741d9; border-color: rgba(103,65,217,0.3); background: rgba(103,65,217,0.06); }
  .cat-vision   { color: #1c6ea4; border-color: rgba(28,110,164,0.3); background: rgba(28,110,164,0.06); }
  .cat-audio    { color: #b8470b; border-color: rgba(184,71,11,0.3); background: rgba(184,71,11,0.06); }
  .cat-robotics { color: #c2410c; border-color: rgba(194,65,12,0.35); background: rgba(194,65,12,0.06); }
  .cat-data     { color: #15803d; border-color: rgba(21,128,61,0.3); background: rgba(21,128,61,0.06); }
  .cat-reason   { color: #a16207; border-color: rgba(161,98,7,0.3); background: rgba(161,98,7,0.06); }
  .cat-compute  { color: #475569; border-color: rgba(71,85,105,0.3); background: rgba(71,85,105,0.06); }
  .cat-storage  { color: #854d0e; border-color: rgba(133,77,14,0.3); background: rgba(133,77,14,0.06); }

  .dot-active { width: 6px; height: 6px; border-radius: 999px; background: #16a34a; box-shadow: 0 0 6px rgba(22,163,74,0.4); display: inline-block; }
  .dot-new    { width: 6px; height: 6px; border-radius: 999px; background: #b8470b; box-shadow: 0 0 6px rgba(184,71,11,0.4); display: inline-block; }
  .dot-stale  { width: 6px; height: 6px; border-radius: 999px; background: #b8b8be; display: inline-block; }

  .pos { color: #15803d; }
  .neg { color: #b91c1c; }
  .spark { display: inline-block; vertical-align: middle; }
  .pb-yes { color: #15803d; font-family: var(--font-mono); font-size: 10px; }
  .pb-no  { color: #767680; font-family: var(--font-mono); font-size: 10px; }
  .pb-stale  { color: #b8470b; font-family: var(--font-mono); font-size: 10px; }

  .ref-badge { display: inline-flex; align-items: center; gap: 4px; font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.08em; text-transform: uppercase; padding: 2px 6px; border-radius: 3px; background: rgba(184,71,11,0.1); color: #b8470b; border: 1px solid rgba(184,71,11,0.3); margin-left: 6px; vertical-align: middle; }

  .tabular { font-variant-numeric: tabular-nums; }
</style>
