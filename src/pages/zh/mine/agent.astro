---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SubNav from '../../../components/SubNav.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { localizePath, hasZh } from '../../../i18n/utils';

// Section tabs localize to /zh when that page exists, else fall back to English.
const L = (route: string) => localizePath(route, hasZh(route) ? 'zh' : 'en');
const subnav = [
  { href: L('/mine/agent'), label: '用 agent 挖矿' },
  { href: L('/mine/general-setup'), label: '通用配置' },
  { href: L('/mine/playbooks'), label: 'Subnet Playbook' },
  { href: L('/mine/resources'), label: '资源' },
];

const MCP = 'https://opentao-mcp.cameron-530.workers.dev/mcp';

const connectors = [
  { name: 'Claude Code', note: '终端一行搞定', code: `claude mcp add --transport http opentao ${MCP}` },
  { name: 'Cursor / Windsurf', note: '写进 ~/.cursor/mcp.json', code: `{
  "mcpServers": {
    "opentao": { "url": "${MCP}" }
  }
}` },
  { name: 'Claude Desktop', note: 'claude_desktop_config.json(走 mcp-remote)', code: `{
  "mcpServers": {
    "opentao": {
      "command": "npx",
      "args": ["mcp-remote", "${MCP}"]
    }
  }
}` },
];

const prompts = [
  '我有张 4090,该挖哪个 subnet?为什么?',
  '带我一步步把 subnet 9(IOTA)挖起来——硬件、repo、命令。',
  '现在挖 subnet 18 值不值?它的奖励分布是什么样?',
  '如果我按 $2/hr 租一张 H100,挖哪个 subnet 的 P&L 最好?',
];

const tools = [
  { name: 'list_subnets', desc: '按 emission、矿工数、reward spread、playbook 状态扫全部 128 个 subnet。' },
  { name: 'recommend_subnets', desc: '按你的硬件、预算、目标排序推荐——每条带理由。' },
  { name: 'get_subnet', desc: '某个 subnet 的完整经济数据 + 硬件 + 链接。' },
  { name: 'get_playbook', desc: '分步:硬件、repo、安装/运行命令、打分、盈利。' },
  { name: 'estimate_pnl', desc: '给定硬件成本和币价,估某个 subnet 的日/月 P&L。' },
  { name: 'get_setup_guide', desc: '注册任何 subnet 前那套一次性的钱包 + btcli 配置。' },
  { name: 'get_resources', desc: '钱包和 GPU 租用的去处。' },
];
---
<BaseLayout
  title="用 agent 挖矿 — OpenTAO"
  description="别翻 128 份 playbook。把 agent 接到 OpenTAO 的 MCP,直接问该挖哪个、怎么挖。实时数据、验证过的 playbook、只读。"
  section="mine"
>
  <SubNav items={subnav} active="/mine/agent" rightMeta="MCP · 只读 · 实时数据" />

  <section class="border-b hairline">
    <div class="max-w-[1100px] mx-auto px-6 pt-12 pb-10">
      <Breadcrumb crumbs={[
        { href: '/zh/', label: 'OpenTAO' },
        { href: '/mine/agent', label: '开始挖矿' },
        { label: '用 agent 挖矿' },
      ]} />

      <div class="flex items-center gap-2 mb-5">
        <span class="accent-dot"></span><span class="section-label">OpenTAO MCP</span>
      </div>
      <h1 class="text-[44px] leading-[1.05] tracking-[-0.025em] font-semibold max-w-[720px]">别翻 128 份 playbook。<br />问你的 agent。</h1>
      <p class="text-[color:var(--color-fg-muted)] mt-4 max-w-[620px] leading-relaxed">
        把任何支持 MCP 的 agent 接到 OpenTAO。它能扫每个 subnet 的实时经济数据、调出验证过的 playbook、按你的硬件告诉你挖什么,
        再把该跑的命令原样给你。
        <span class="text-[color:var(--color-fg)]">它不会动你的 TAO、也不会替你跑任何东西</span>——只读,主动权在你。
      </p>
    </div>
  </section>

  <section class="border-b hairline">
    <div class="max-w-[1100px] mx-auto px-6 py-12">
      <div class="section-label mb-2">30 秒接上</div>
      <div class="flex items-center gap-2 mb-6 text-sm">
        <span class="text-[color:var(--color-fg-muted)]">Endpoint</span>
        <code class="endpoint" data-copy>{MCP}</code>
        <button class="copy-btn" data-copy-target>复制</button>
      </div>

      <div class="grid md:grid-cols-3 gap-4">
        {connectors.map((c) => (
          <div class="card rounded-md p-5 flex flex-col">
            <div class="font-medium mb-0.5">{c.name}</div>
            <div class="text-xs text-[color:var(--color-fg-dim)] font-mono mb-3">{c.note}</div>
            <div class="code-snip relative">
              <pre>{c.code}</pre>
              <button class="copy-btn abs" data-copy-target>复制</button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b hairline">
    <div class="max-w-[1100px] mx-auto px-6 py-12">
      <div class="section-label mb-5">然后直接问</div>
      <div class="grid sm:grid-cols-2 gap-3">
        {prompts.map((p) => (
          <div class="prompt-card">
            <span class="quote">"</span>{p}
            <button class="copy-btn inline-c" data-copy-text={p}>复制</button>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b hairline">
    <div class="max-w-[1100px] mx-auto px-6 py-12">
      <div class="section-label mb-5">它能干什么 · 7 个工具</div>
      <div class="grid md:grid-cols-2 gap-x-10 gap-y-4">
        {tools.map((t) => (
          <div class="flex gap-3 items-baseline border-b hairline pb-4">
            <code class="tool-name">{t.name}</code>
            <span class="text-sm text-[color:var(--color-fg-muted)]">{t.desc}</span>
          </div>
        ))}
      </div>
      <p class="mt-6 text-xs font-mono text-[color:var(--color-fg-dim)] max-w-[680px]">
        和站点其它地方同一个数据源(<a href="/mining-data.json" class="underline underline-offset-2 hover:text-[color:var(--color-fg)]">/mining-data.json</a>),从链上刷新。
        任何要花 TAO 或 GPU 的动作——注册、跑 miner——都只会以命令形式返回,由你自己跑、自己确认,agent 不会执行。
      </p>
    </div>
  </section>

  <script>
    function flash(btn: HTMLElement) {
      const prev = btn.textContent;
      btn.textContent = '已复制';
      btn.classList.add('copied');
      setTimeout(() => { btn.textContent = prev; btn.classList.remove('copied'); }, 1200);
    }
    document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        let text = btn.getAttribute('data-copy-text') || '';
        if (!text) {
          const card = btn.closest('.code-snip, section, .prompt-card, div');
          const pre = card?.querySelector('pre');
          const ep = card?.querySelector('.endpoint');
          text = (pre?.textContent || ep?.textContent || '').trim();
        }
        if (!text) return;
        try { await navigator.clipboard.writeText(text); flash(btn); } catch {}
      });
    });
  </script>
</BaseLayout>

<style>
  .endpoint { font-family: var(--font-mono); font-size: 12px; background: #fafaf9; border: 1px solid rgba(15,15,18,0.1); padding: 4px 8px; border-radius: 4px; color: #0c0c10; }
  .copy-btn { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; color: #767680; cursor: pointer; background: transparent; border: 0; padding: 2px 4px; transition: color .12s; }
  .copy-btn:hover { color: #0c0c10; }
  .copy-btn.copied { color: #15803d; }
  .copy-btn.abs { position: absolute; top: 8px; right: 8px; }
  .copy-btn.inline-c { position: absolute; bottom: 10px; right: 10px; }
  .code-snip { background: #0c0c10; border-radius: 6px; padding: 14px 14px; margin-top: auto; }
  .code-snip pre { font-family: var(--font-mono); font-size: 11.5px; line-height: 1.55; color: #e8e6e2; white-space: pre-wrap; word-break: break-all; margin: 0; }
  .prompt-card { position: relative; border: 1px solid rgba(15,15,18,0.1); border-radius: 8px; padding: 16px 18px 30px; font-size: 14px; color: #1c1c22; line-height: 1.5; background: #fff; }
  .prompt-card .quote { font-family: var(--font-serif); color: #b8470b; font-size: 20px; margin-right: 2px; }
  .tool-name { font-family: var(--font-mono); font-size: 12px; color: #b8470b; white-space: nowrap; }
</style>
