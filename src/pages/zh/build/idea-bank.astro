const computeRowsA = [
  { g: '1× GPU', w: 20, t: '1k/天' }, { g: '2× GPU', w: 22, t: '1.1k/天' },
  { g: '4× GPU', w: 24, t: '1.2k/天' }, { g: '8× GPU', w: 24, t: '1.2k/天' },
