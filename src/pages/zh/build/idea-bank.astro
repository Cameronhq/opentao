const refSubnets = [
  { slug: '64-chutes',   netuid: '64',  name: 'Chutes',   body: '推理市场,对输出字节有硬确定性。L3/L4 干净。' },
  { slug: '22-desearch', netuid: '22',  name: 'Desearch', body: '搜索排序,对照轮换的私有 gold set 判分。L3 很强。' },
