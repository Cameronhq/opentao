---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SubNav from '../../../../components/SubNav.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import { localizePath, hasZh } from '../../../../i18n/utils';

const L = (route: string) => localizePath(route, hasZh(route) ? 'zh' : 'en');
const subnav = [
  { href: L('/community/events'), label: '活动' },
  { href: L('/community/chapters'), label: '城市分会' },
  { href: L('/community/insights'), label: '长文' },
];

const stats = [
  { label: '办过活动', n: '12', sub: '近 90 天 +3' },
  { label: '成员', n: '412', sub: 'Discord + Telegram' },
  { label: '到场', n: '68', unit: '/场', sub: '近 6 场平均' },
  { label: '回顾完成率', n: '92%', sub: '7 天内发出' },
];

const past = [
  { month: 'Mar', day: '14', title: '东京 Meetup #02 — Validator 之夜', meta: '64 人参加', links: [{ label: '回顾' }, { label: '照片' }, { label: 'YouTube' }] },
  { month: 'Feb', day: '22', title: 'Workshop — 挖你的第一个 subnet', meta: '38 人参加', links: [{ label: '回顾' }, { label: '幻灯' }] },
  { month: 'Jan', day: '18', title: '东京 Meetup #01 — Kickoff', meta: '87 人参加', links: [{ label: '回顾' }, { label: '照片' }] },
  { month: 'Dec', day: '12', title: '年终 retreat — 箱根', meta: '22 人参加 · 仅邀请', links: [{ label: '记录' }] },
];

const partners = [
  { name: 'WeWork', meta: '场地' },
  { name: 'HackQuest', meta: '媒体' },
  { name: 'Asahi', meta: '酒水' },
  { name: 'Lambda Labs', meta: '算力' },
  { name: '东京大学', meta: '教育' },
  { name: '+ 还有 2 家', meta: '' },
];
---
<BaseLayout
  title="东京分会 — 社区 — OpenTAO"
  description="大东京 Bittensor 分会。每月 meetup,偶尔 workshop,日英双语。"
  section="community"
>
  <SubNav items={subnav} active="/community/chapters" rightMeta="自 2025-09 · 活跃" />

  <section class="relative overflow-hidden border-b hairline">
    <div class="absolute inset-0 dot-grid opacity-40"></div>
    <div class="relative max-w-[1200px] mx-auto px-6 pt-16 pb-12">
      <Breadcrumb crumbs={[
        { href: '/zh/', label: 'OpenTAO' },
        { href: '/community/events', label: '社区' },
        { href: '/community/chapters', label: '城市分会' },
        { label: '东京' },
      ]} />

      <div class="grid lg:grid-cols-[1.4fr_1fr] gap-12 items-end">
        <div>
          <div class="flex items-center gap-3 mb-5">
            <span class="text-3xl">🇯🇵</span>
            <span class="tag" style="color: #15803d; border-color: rgba(21,128,61,0.3); background: rgba(21,128,61,0.06);">活跃</span>
            <span class="tag">日本語 · English</span>
            <span class="text-xs text-[color:var(--color-fg-dim)] font-mono">自 2025·09·12</span>
          </div>
          <h1 class="text-[64px] md:text-[80px] leading-[0.95] tracking-[-0.03em] font-semibold">
            <span class="font-serif italic font-normal text-[color:var(--color-fg-muted)]">Bittensor </span>东京<span class="text-[color:var(--color-accent)]">.</span>
          </h1>
          <p class="mt-6 text-lg text-[color:var(--color-fg-muted)] max-w-[560px] leading-relaxed">大东京——涩谷、六本木、横滨。每月 meetup、偶尔 workshop、一场年终大会。默认日英双语。</p>
          <div class="mt-7 flex flex-wrap items-center gap-3">
            <a href="#" class="btn-primary inline-flex items-center gap-2 text-sm font-semibold px-5 py-2.5 rounded-md">加入 Discord<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M9 7h8v8"/></svg></a>
            <a href="#" class="btn-secondary inline-flex items-center gap-2 text-sm font-medium px-4 py-2.5 rounded-md">在 X 上关注</a>
            <a href={L('/community/become-a-host')} class="text-xs text-[color:var(--color-fg-muted)] hover:text-[color:var(--color-fg)] ml-2 font-mono">+ 来当 co-host</a>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          {stats.map((s) => (
            <div class="stat"><div class="section-label">{s.label}</div><div class="n mt-2">{s.n}{s.unit && <span class="text-base text-[color:var(--color-fg-muted)]">{s.unit}</span>}</div><div class="text-xs font-mono text-[color:var(--color-fg-dim)] mt-1">{s.sub}</div></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="border-b hairline">
    <div class="max-w-[1200px] mx-auto px-6 py-16">
      <div class="grid lg:grid-cols-[1fr_2fr] gap-12">

        <aside class="lg:sticky lg:top-24 lg:self-start space-y-5 text-sm">
          <div>
            <div class="section-label mb-2">章程</div>
            <p class="text-[color:var(--color-fg-muted)] leading-relaxed">定期把 Bittensor 的 APAC 社区聚到一个房间。降低日本第一次上手的 builder 参与主网、黑客松、孵化器管线的门槛。</p>
          </div>
          <div>
            <div class="section-label mb-2">语言</div>
            <p class="text-[color:var(--color-fg-muted)]">日语为主 · 英语为辅 · 幻灯双语</p>
          </div>
          <div>
            <div class="section-label mb-2">频率</div>
            <p class="text-[color:var(--color-fg-muted)]">每月 meetup · 每季度 workshop · 年度年终 retreat</p>
          </div>
          <div>
            <div class="section-label mb-2">覆盖范围</div>
            <p class="text-[color:var(--color-fg-muted)]">大东京 · 横滨 · 千叶</p>
          </div>
          <div class="pt-4 border-t hairline">
            <div class="section-label mb-2">行为准则</div>
            <p class="text-[color:var(--color-fg-muted)] leading-relaxed">不喊单、不谈投资、未经同意不录音。<a href="#" class="text-[color:var(--color-fg)] underline underline-offset-2 hover:text-[color:var(--color-accent)]">读全文</a>。</p>
          </div>
        </aside>

        <div>
          <div class="section-label mb-3">下一批</div>
          <h2 class="text-2xl font-semibold tracking-tight mb-6">排期上有三场。</h2>
          <div class="space-y-3 mb-12">
            <a href={L('/community/events/2026-tokyo-meetup-03')} class="card rounded-md p-5 flex items-center gap-5 block" style="border-color: rgba(184,71,11,0.3); background: rgba(184,71,11,0.03);">
              <div class="date-block" style="background: rgba(184,71,11,0.06); border-color: rgba(184,71,11,0.2);"><div class="month" style="color: #b8470b;">Jun</div><div class="day" style="color: #b8470b;">08</div></div>
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-1.5"><span class="tag">Meetup</span><span class="tag">线下</span></div>
                <h4 class="font-semibold tracking-tight">Bittensor 东京 Meetup #03</h4>
                <div class="text-xs font-mono text-[color:var(--color-fg-dim)] mt-1.5">涩谷 · 19:00 JST · 已报名 62 / 80</div>
              </div>
              <div class="text-xs text-[color:var(--color-fg-muted)] font-mono whitespace-nowrap">还有 12 天</div>
            </a>
            <a href="#" class="card rounded-md p-5 flex items-center gap-5 block">
              <div class="date-block"><div class="month">Jul</div><div class="day">15</div></div>
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-1.5"><span class="tag">Workshop</span></div>
                <h4 class="font-semibold tracking-tight">Workshop · 子网建模与算力测试</h4>
                <div class="text-xs font-mono text-[color:var(--color-fg-dim)] mt-1.5">六本木 · 14:00 JST · 日语</div>
              </div>
              <div class="text-xs text-[color:var(--color-fg-muted)] font-mono whitespace-nowrap">还有 49 天</div>
            </a>
            <a href="#" class="card rounded-md p-5 flex items-center gap-5 block">
              <div class="date-block"><div class="month">Aug</div><div class="day">02</div></div>
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-1.5"><span class="tag">Meetup</span></div>
                <h4 class="font-semibold tracking-tight">Bittensor 东京 Meetup #04 — 夏日版</h4>
                <div class="text-xs font-mono text-[color:var(--color-fg-dim)] mt-1.5">横滨海滨 · 17:00 JST · 户外 BBQ</div>
              </div>
              <div class="text-xs text-[color:var(--color-fg-muted)] font-mono whitespace-nowrap">还有 67 天</div>
            </a>
          </div>

          <div class="section-label mb-3">往期活动</div>
          <h2 class="text-2xl font-semibold tracking-tight mb-6">这个分会去过哪。</h2>
          <div class="space-y-2 mb-4">
            {past.map((e) => (
              <a href="#" class="card rounded-md p-4 flex items-center gap-4 block">
                <div class="date-block"><div class="month">{e.month}</div><div class="day">{e.day}</div></div>
                <div class="flex-1">
                  <h5 class="font-medium text-sm">{e.title}</h5>
                  <div class="text-xs font-mono text-[color:var(--color-fg-dim)] mt-0.5">
                    {e.meta} · {e.links.map((l, i) => (
                      <>{i > 0 && ' · '}<a href="#" class="hover:text-[color:var(--color-accent)] underline underline-offset-2">{l.label}</a></>
                    ))}
                  </div>
                </div>
              </a>
            ))}
          </div>
          <a href="#" class="text-xs text-[color:var(--color-accent)] hover:underline font-mono">全部 12 场往期活动 →</a>
        </div>

      </div>
    </div>
  </section>

  <section class="border-b hairline bg-[color:var(--color-surface)]">
    <div class="max-w-[1200px] mx-auto px-6 py-16">
      <div class="section-label mb-3">主理人</div>
      <h2 class="text-3xl font-semibold tracking-tight mb-10">两个会出现的人。</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="host-card bg-[color:var(--color-paper)]">
          <div class="av" style="background: linear-gradient(135deg, #b8470b, #c2410c);"></div>
          <div class="flex-1">
            <div class="flex items-baseline gap-2 mb-1"><h4 class="font-semibold">Yuki Tanaka</h4><span class="tag">Lead host</span></div>
            <div class="text-xs font-mono text-[color:var(--color-fg-dim)] mb-3">@yuki · 自 2025-09</div>
            <p class="text-sm text-[color:var(--color-fg-muted)] leading-relaxed mb-3">东京一家机器人创业公司的资深工程师。2024 年搭了日本最早的 miner 节点之一。信奉"先喝酒、后讲幻灯"的 meetup。</p>
            <div class="flex gap-2 text-xs"><a href="#" class="text-[color:var(--color-fg-dim)] hover:text-[color:var(--color-fg)]">Twitter</a> · <a href="#" class="text-[color:var(--color-fg-dim)] hover:text-[color:var(--color-fg)]">GitHub</a> · <a href="#" class="text-[color:var(--color-fg-dim)] hover:text-[color:var(--color-fg)]">网站</a></div>
          </div>
        </div>
        <div class="host-card bg-[color:var(--color-paper)]">
          <div class="av" style="background: linear-gradient(135deg, #1c6ea4, #6741d9);"></div>
          <div class="flex-1">
            <div class="flex items-baseline gap-2 mb-1"><h4 class="font-semibold">Takahiro Sato</h4><span class="tag">Co-host</span></div>
            <div class="text-xs font-mono text-[color:var(--color-fg-dim)] mb-3">@takahiro · 自 2026-02</div>
            <p class="text-sm text-[color:var(--color-fg-muted)] leading-relaxed mb-3">quant 研究员;业余跑一个 SN-5 validator。负责后勤、场地、翻译。临时乱局里很稳。</p>
            <div class="flex gap-2 text-xs"><a href="#" class="text-[color:var(--color-fg-dim)] hover:text-[color:var(--color-fg)]">Twitter</a> · <a href="#" class="text-[color:var(--color-fg-dim)] hover:text-[color:var(--color-fg)]">GitHub</a></div>
          </div>
        </div>
      </div>

      <div class="mt-10 grid md:grid-cols-2 gap-8">
        <div>
          <div class="section-label mb-3">场地 & 赞助伙伴</div>
          <div class="grid grid-cols-3 gap-3">
            {partners.map((p) => (
              <div class="card rounded-md p-4 text-center text-xs font-mono text-[color:var(--color-fg-dim)] bg-[color:var(--color-paper)]">{p.name}{p.meta && <><br><span class="text-[10px] mt-1 block">{p.meta}</span></>}</div>
            ))}
          </div>
        </div>
        <div>
          <div class="section-label mb-3">报销透明</div>
          <div class="card rounded-md p-5 bg-[color:var(--color-paper)] text-sm">
            <div class="flex justify-between py-2 border-b hairline"><span class="text-[color:var(--color-fg-muted)]">2026 Q1 已花</span><span class="font-mono">¥184,200</span></div>
            <div class="flex justify-between py-2 border-b hairline"><span class="text-[color:var(--color-fg-muted)]">2026 Q2 预算</span><span class="font-mono">¥240,000</span></div>
            <div class="flex justify-between py-2"><span class="text-[color:var(--color-fg-muted)]">年初至今资助场次</span><span class="font-mono">3</span></div>
            <a href="#" class="text-xs text-[color:var(--color-accent)] hover:underline font-mono mt-2 inline-block">看明细 →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b hairline">
    <div class="max-w-[1200px] mx-auto px-6 py-16">
      <div class="grid md:grid-cols-3 gap-4">
        <div class="card rounded-md p-6">
          <div class="section-label mb-3">参与进来</div>
          <h4 class="font-semibold mb-2">加入群聊</h4>
          <p class="text-sm text-[color:var(--color-fg-muted)] leading-relaxed mb-4">Discord 频道(每天都活跃)+ 一个更安静的 Telegram 群发公告。</p>
          <a href="#" class="text-sm text-[color:var(--color-accent)] hover:underline">Discord 邀请 →</a>
        </div>
        <div class="card rounded-md p-6">
          <div class="section-label mb-3">提议话题</div>
          <h4 class="font-semibold mb-2">来做个分享</h4>
          <p class="text-sm text-[color:var(--color-fg-muted)] leading-relaxed mb-4">在做 subnet、validator 或研究?我们给你安排时段。</p>
          <a href="#" class="text-sm text-[color:var(--color-accent)] hover:underline">提交话题 →</a>
        </div>
        <div class="card rounded-md p-6">
          <div class="section-label mb-3">和我们共同主理</div>
          <h4 class="font-semibold mb-2">来当 co-host</h4>
          <p class="text-sm text-[color:var(--color-fg-muted)] leading-relaxed mb-4">如果你本来就常来,这就是自然的下一步。</p>
          <a href={L('/community/become-a-host')} class="text-sm text-[color:var(--color-accent)] hover:underline">申请 →</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .stat { padding: 24px; border: 1px solid rgba(15,15,18,0.08); border-radius: 6px; background: #fafaf9; }
  .stat .n { font-size: 32px; font-weight: 600; font-feature-settings: "tnum"; letter-spacing: -0.02em; }
  .tag { font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: 0.08em; text-transform: uppercase; padding: 3px 7px; border-radius: 3px; border: 1px solid rgba(15,15,18,0.14); color: #4a4a52; }
  .date-block { font-family: 'JetBrains Mono', monospace; text-align: center; padding: 10px 12px; background: #fafaf9; border-radius: 6px; min-width: 56px; border: 1px solid rgba(15,15,18,0.07); }
  .date-block .month { font-size: 10px; color: #767680; letter-spacing: 0.15em; text-transform: uppercase; }
  .date-block .day { font-size: 18px; font-weight: 600; color: #0c0c10; line-height: 1; margin-top: 3px; }
  .host-card { display: flex; align-items: flex-start; gap: 14px; padding: 18px; border: 1px solid rgba(15,15,18,0.08); border-radius: 6px; background: #ffffff; }
  .host-card .av { width: 48px; height: 48px; border-radius: 50%; flex-shrink: 0; }
</style>
