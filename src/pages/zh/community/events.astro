---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SubNav from '../../../components/SubNav.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { localizePath, hasZh } from '../../../i18n/utils';

const L = (route: string) => localizePath(route, hasZh(route) ? 'zh' : 'en');
const subnav = [
  { href: L('/community/events'), label: '活动' },
  { href: L('/community/chapters'), label: '城市分会' },
  { href: L('/community/insights'), label: '长文' },
];

interface UpcomingItem {
  href: string; month: string; day: string; tags: { label: string; cls: string }[];
  title: string; meta: string; when: string; category: string; mode: string;
}

const upcoming: UpcomingItem[] = [
  { href: '/community/events/2026-sn3-fireside-ke-ng', month: 'Jun', day: '12', tags: [{ label: 'Online · AMA', cls: 'tag tag-online' }], title: '"运营 SN3 一年我们学到了什么" — 与 @ke.ng 炉边谈', meta: 'Discord stage · 09:00 PST · 60 分钟', when: '还有 16 天', category: 'AMA', mode: 'Online' },
  { href: '/community/events/2026-sf-build-first-subnet', month: 'Jun', day: '15', tags: [{ label: 'Workshop', cls: 'tag' }, { label: 'In-person', cls: 'tag' }], title: '旧金山 —「4 小时做出你的第一个 subnet」', meta: '📍 Mission · 10:00 PST · SF 分会主办', when: '还有 19 天', category: 'Workshop', mode: 'In-person' },
  { href: '/community/events/2026-hackathon-mid-checkpoint', month: 'Jun', day: '22', tags: [{ label: 'Hackathon · kick-off', cls: 'tag tag-hackathon' }], title: '中期 demo · 第一季黑客松', meta: 'Hybrid · 6 城 · 各地 18:00 · 欢迎观摩', when: '还有 26 天', category: 'Hackathon', mode: 'Hybrid' },
  { href: '/community/events/2026-berlin-garden-edition', month: 'Jun', day: '28', tags: [{ label: 'Meetup', cls: 'tag' }, { label: 'In-person', cls: 'tag' }], title: '柏林 — Bittensor 花园版', meta: '📍 Kreuzberg · 17:00 CEST · BBQ + 简短分享', when: '还有 32 天', category: 'Meetup', mode: 'In-person' },
  { href: '/community/events/2026-validator-night-bonding', month: 'Jul', day: '06', tags: [{ label: 'Online · Workshop', cls: 'tag tag-online' }], title: 'Validator 之夜 — bonding 与 trust 校准', meta: 'Discord stage · 18:00 UTC · 90 分钟 · 面向有经验的 validator', when: '还有 40 天', category: 'Workshop', mode: 'Online' },
];
---
<BaseLayout
  title="活动 — 社区 — OpenTAO"
  description="12 个 OpenTAO 分会的 meetup、AMA、workshop、demo day。"
  section="community"
>
  <SubNav items={subnav} active="/community/events" rightMeta="12 场即将开始 · 6 座城市" />

  <section class="relative overflow-hidden border-b hairline">
    <div class="absolute inset-0 dot-grid opacity-40"></div>
    <div class="relative max-w-[1200px] mx-auto px-6 pt-20 pb-14">
      <Breadcrumb crumbs={[
        { href: '/zh/', label: 'OpenTAO' },
        { href: '/community/events', label: '社区' },
        { label: '活动' },
      ]} />
      <h1 class="text-[60px] md:text-[72px] leading-[0.98] tracking-[-0.03em] font-semibold">
        <span class="font-serif italic font-normal text-[color:var(--color-fg-muted)]">找到 </span>同路人<span class="text-[color:var(--color-accent)]">.</span>
      </h1>
      <p class="mt-7 text-lg text-[color:var(--color-fg-muted)] max-w-[620px] leading-relaxed">Meetup、AMA、workshop、demo day。在 Luma 报名——我们只负责把单子更新好。这一季 12 场,横跨六座城市。</p>
    </div>
  </section>

  <section class="border-b hairline">
    <div class="max-w-[1200px] mx-auto px-6 py-5 grid grid-cols-2 md:grid-cols-4 gap-6 text-sm">
      <div><div class="text-[11px] font-mono text-[color:var(--color-fg-dim)] uppercase tracking-wider mb-1">本月</div><div class="font-semibold text-2xl tracking-tight">8 场</div><div class="text-xs text-[color:var(--color-fg-dim)] font-mono mt-0.5">3 场线下 · 5 场线上</div></div>
      <div><div class="text-[11px] font-mono text-[color:var(--color-fg-dim)] uppercase tracking-wider mb-1">活跃分会</div><div class="font-semibold text-2xl tracking-tight">12 座城市</div><div class="text-xs text-[color:var(--color-fg-dim)] font-mono mt-0.5">+2 筹建</div></div>
      <div><div class="text-[11px] font-mono text-[color:var(--color-fg-dim)] uppercase tracking-wider mb-1">年初至今参与</div><div class="font-semibold text-2xl tracking-tight">3,180</div><div class="text-xs text-[color:var(--color-fg-dim)] font-mono mt-0.5">平均每场 68</div></div>
      <div class="flex flex-col">
        <div class="text-[11px] font-mono text-[color:var(--color-fg-dim)] uppercase tracking-wider mb-1">订阅</div>
        <div class="flex gap-1.5 mt-1 flex-wrap">
          <a href="/events.ics" class="pill text-xs">📅 iCal</a>
          <a href="/events.xml" class="pill text-xs">RSS</a>
          <span class="pill text-xs" style="cursor: default; opacity: 0.6;">✉ 邮件 <span class="ml-1 coming-soon" style="font-size: 8px; padding: 1px 5px;">即将</span></span>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b hairline bg-[color:var(--color-surface)]">
    <div class="max-w-[1200px] mx-auto px-6 py-5">
      <div class="flex items-center gap-6 flex-wrap">
        <div class="flex border hairline rounded-md overflow-hidden text-sm">
          <button class="px-4 py-2 bg-[color:var(--color-paper)] border-r hairline text-[color:var(--color-fg)] flex items-center gap-1.5" disabled style="cursor: default;"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><circle cx="4" cy="6" r="1"/><circle cx="4" cy="12" r="1"/><circle cx="4" cy="18" r="1"/></svg>列表</button>
          <button class="px-4 py-2 text-[color:var(--color-fg-dim)] border-r hairline flex items-center gap-1.5" disabled title="即将上线" style="cursor: not-allowed; opacity: 0.55;"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>日历</button>
          <button class="px-4 py-2 text-[color:var(--color-fg-dim)] flex items-center gap-1.5" disabled title="即将上线" style="cursor: not-allowed; opacity: 0.55;"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/><line x1="8" y1="2" x2="8" y2="18"/><line x1="16" y1="6" x2="16" y2="22"/></svg>地图</button>
        </div>
        <div class="flex flex-wrap items-center gap-2 ml-auto">
          <button class="pill active" data-filter-evt="all">全部</button>
          <button class="pill" data-filter-evt="In-person">线下</button>
          <button class="pill" data-filter-evt="Online">线上</button>
          <button class="pill" data-filter-evt="Hackathon">黑客松</button>
          <button class="pill" data-filter-evt="Workshop">Workshop</button>
          <button class="pill" data-filter-evt="AMA">AMA</button>
          <span class="pill" style="cursor: default; opacity: 0.6;">📍 全部城市 <span class="coming-soon" style="font-size: 8px; padding: 1px 5px; margin-left: 4px;">即将</span></span>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b hairline">
    <div class="max-w-[1200px] mx-auto px-6 py-14">
      <div class="section-label mb-5">下一场</div>
      <a id="featured-evt" href={L('/community/events/2026-tokyo-meetup-03')} class="card rounded-md p-8 grid lg:grid-cols-[auto_1fr_auto] gap-8 items-center" data-evt-category="Meetup" data-evt-mode="In-person">
        <div class="date-block"><div class="month">Jun</div><div class="day">08</div></div>
        <div>
          <div class="flex items-center gap-2 mb-3"><span class="tag">Meetup</span><span class="tag">线下</span><span class="text-xs text-[color:var(--color-fg-dim)] font-mono">· 东京分会主办</span></div>
          <h2 class="text-2xl font-semibold tracking-tight mb-2">Bittensor 东京 Meetup #03</h2>
          <p class="text-[color:var(--color-fg-muted)] text-sm leading-relaxed max-w-[600px]">三位 subnet 创始人聊聊"第一天要是知道就好了"的事。结束后还有酒。WeWork 涩谷,19:00 JST。</p>
          <div class="mt-4 flex items-center gap-5 text-xs font-mono text-[color:var(--color-fg-dim)]"><span>📍 东京涩谷</span><span>🕒 19:00 – 22:00 JST</span><span>👥 已报名 80 / 120</span></div>
        </div>
        <div class="flex flex-col items-end gap-2">
          <span class="inline-flex items-center gap-2 text-sm font-semibold px-5 py-2.5 rounded-md" style="background: #b8470b; color: #ffffff;">
            看详情
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </span>
          <span class="text-xs font-mono text-[color:var(--color-fg-dim)]">还有 12 天</span>
        </div>
      </a>
    </div>
  </section>

  <section class="border-b hairline">
    <div class="max-w-[1200px] mx-auto px-6 py-14">
      <div class="section-label mb-6">全部即将开始</div>
      <div class="space-y-3" id="events-list">
        {upcoming.map((e) => (
          <a href={e.href} class="card rounded-md p-5 flex items-center gap-6 block" data-evt-category={e.category} data-evt-mode={e.mode}>
            <div class="date-block"><div class="month">{e.month}</div><div class="day">{e.day}</div></div>
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-1.5">{e.tags.map((t) => <span class={t.cls}>{t.label}</span>)}</div>
              <h3 class="font-semibold tracking-tight">{e.title}</h3>
              <div class="text-xs font-mono text-[color:var(--color-fg-dim)] mt-1.5">{e.meta}</div>
            </div>
            <div class="text-sm text-[color:var(--color-fg-muted)] font-mono whitespace-nowrap">{e.when}</div>
          </a>
        ))}
        <a href="/community/events/2026-sf-demo-day-season-01" class="card rounded-md p-5 flex items-center gap-6 block" style="border-color: rgba(184,71,11,0.3); background: rgba(184,71,11,0.03);" data-evt-category="Demo day" data-evt-mode="In-person">
          <div class="date-block" style="background: rgba(184,71,11,0.06); border-color: rgba(184,71,11,0.2);"><div class="month" style="color: #b8470b;">Jul</div><div class="day" style="color: #b8470b;">22</div></div>
          <div class="flex-1">
            <div class="flex items-center gap-2 mb-1.5"><span class="tag tag-hackathon">Demo day</span><span class="tag">线下 + 直播</span></div>
            <h3 class="font-semibold tracking-tight">第一季 Demo Day · SF</h3>
            <div class="text-xs font-mono text-[color:var(--color-fg-dim)] mt-1.5">📍 SF + 全球直播 · 10:00 PT · 30 强 pitch</div>
          </div>
          <div class="text-sm text-[color:var(--color-fg-muted)] font-mono whitespace-nowrap">还有 56 天</div>
        </a>
      </div>
    </div>
  </section>

  <section class="border-b hairline">
    <div class="max-w-[1200px] mx-auto px-6 py-14">
      <div class="grid md:grid-cols-[1.4fr_1fr] gap-10 items-center">
        <div>
          <div class="section-label mb-3">你的城市没有活动?</div>
          <h3 class="text-3xl font-serif italic font-medium leading-snug max-w-[480px]">来当主理人。申请就一段话。</h3>
          <p class="text-[color:var(--color-fg-muted)] text-sm mt-4 max-w-[480px] leading-relaxed">我们给你品牌物料、主理人 playbook、餐饮/场地报销。你给它三个月的尝试。</p>
        </div>
        <a href={L('/community/chapters')} class="card rounded-md p-6 block">
          <div class="section-label mb-2">→ 来当主理人</div>
          <h4 class="font-semibold mb-1">今天有 12 个活跃分会</h4>
          <p class="text-sm text-[color:var(--color-fg-muted)]">东京 · SF · 柏林 · 新加坡 · 深圳 · 纽约 · 伦敦 · 班加罗尔 · 圣保罗 · 首尔 · 等</p>
        </a>
      </div>
    </div>
  </section>

  <script>
    const featured = document.getElementById('featured-evt') as HTMLAnchorElement | null;
    const listed = Array.from(document.querySelectorAll<HTMLAnchorElement>('#events-list > a[data-evt-category]'));
    const all = featured ? [featured, ...listed] : listed;

    document.querySelectorAll<HTMLButtonElement>('[data-filter-evt]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const f = btn.dataset.filterEvt || 'all';
        document.querySelectorAll('[data-filter-evt]').forEach((b) => b.classList.toggle('active', b === btn));
        for (const c of all) {
          if (f === 'all') { c.style.display = ''; continue; }
          const matchMode = c.dataset.evtMode === f;
          const matchCat = c.dataset.evtCategory === f;
          c.style.display = matchMode || matchCat ? '' : 'none';
        }
      });
    });
  </script>
</BaseLayout>

<style>
  .date-block { font-family: 'JetBrains Mono', monospace; text-align: center; padding: 12px 14px; background: #fafaf9; border-radius: 6px; min-width: 64px; border: 1px solid rgba(15,15,18,0.07); }
  .date-block .month { font-size: 10px; color: #767680; letter-spacing: 0.15em; text-transform: uppercase; }
  .date-block .day { font-size: 22px; font-weight: 600; color: #0c0c10; line-height: 1; margin-top: 4px; }
  .pill { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border: 1px solid rgba(15,15,18,0.12); border-radius: 6px; font-size: 13px; color: #4a4a52; background: transparent; }
  .pill:hover { border-color: rgba(15,15,18,0.28); color: #0c0c10; }
  .pill.active { color: #b8470b; border-color: rgba(184,71,11,0.4); background: rgba(184,71,11,0.06); }
  .tag { font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: 0.08em; text-transform: uppercase; padding: 2px 6px; border-radius: 3px; border: 1px solid rgba(15,15,18,0.14); color: #4a4a52; }
  .tag-online { color: #1c6ea4; border-color: rgba(28,110,164,0.3); background: rgba(28,110,164,0.06); }
  .tag-hackathon { color: #b8470b; border-color: rgba(184,71,11,0.3); background: rgba(184,71,11,0.06); }
  .external-icon { display: inline-block; vertical-align: middle; margin-left: 4px; opacity: 0.6; }
</style>
