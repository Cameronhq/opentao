---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SubNav from '../../../components/SubNav.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { localizePath, hasZh } from '../../../i18n/utils';

const L = (route: string) => localizePath(route, hasZh(route) ? 'zh' : 'en');
const subnav = [
  { href: L('/community/events'), label: '活动' },
  { href: L('/community/chapters'), label: '城市分会' },
  { href: L('/community/insights'), label: '长文' },
];

const provides = [
  { title: '每场 $500 报销', body: '餐饮、场地、打印。交收据,出钱。' },
  { title: '品牌套件', body: 'Logo、海报模板、幻灯模板、贴纸图。' },
  { title: '主理人 playbook', body: '一份 14 页的指南,从头到尾教你办第一场。' },
  { title: '周边寄送', body: '每季度贴纸 + T 恤,发给大家的小礼物。' },
  { title: 'OpenTAO 上的展示', body: '分会页面、活动上全球日历、主理人上公开名册。' },
  { title: '资深主理人带', body: '头 90 天给你配一个别的分会的 buddy。' },
];

const eligibility = [
  { title: '对 Bittensor 好奇', body: '不用是专家。教育的脚手架我们给。' },
  { title: '每月约 5 小时', body: '实际的时间投入。淡月更少,活动前后更多。' },
  { title: '一个能触达的人群', body: '一个群、一个公司、一个学校社团——你的头 12 个参与者从哪来。' },
  { title: '同意行为准则', bodyHtml: '包容、不喊单、不谈投资。<a href="https://github.com/Cameronhq/opentao/blob/main/CODE_OF_CONDUCT.md" target="_blank" rel="noopener" class="underline underline-offset-2 hover:text-[color:var(--color-accent)]">读全文</a>。' },
];

const steps = [
  { n: '01 · 第 0 天', title: '提交表单', body: '就在下面。五个字段,五分钟。' },
  { n: '02 · 第 1-7 天', title: '编辑审核', body: '编辑团队 + 2 位资深主理人一起读。' },
  { n: '03 · 第 7-14 天', title: '30 分钟视频', body: '双向了解,看看合不合。' },
  { n: '04 · 第 14-21 天', title: 'Lead Host offer', body: '签 charter,发 onboarding 邮件。' },
  { n: '05 · 第 3-4 周', title: '品牌套件 + buddy', body: '物料寄出,配上资深主理人 buddy。' },
];
---
<BaseLayout
  title="来当主理人 — 社区 — OpenTAO"
  description="一段话。不要 deck。申请在你的城市领一个 Bittensor 分会。"
  section="community"
>
  <SubNav items={subnav} active="/community/chapters" rightMeta="申请 · 5 分钟" />

  <section class="relative overflow-hidden border-b hairline">
    <div class="absolute inset-0 dot-grid opacity-40"></div>
    <div class="relative max-w-[1200px] mx-auto px-6 pt-20 pb-16">
      <Breadcrumb crumbs={[
        { href: '/zh/', label: 'OpenTAO' },
        { href: '/community/events', label: '社区' },
        { href: '/community/chapters', label: '城市分会' },
        { label: '来当主理人' },
      ]} />
      <div class="flex items-center gap-3 mb-5">
        <span class="section-label" style="color: #b8470b;">开放申请 · 滚动收</span>
      </div>
      <h1 class="text-[56px] md:text-[68px] leading-[1.02] tracking-[-0.03em] font-semibold max-w-[840px]">
        <span class="font-serif italic font-normal text-[color:var(--color-fg-muted)]">为你的城市 </span>站出来。<br>场子我们来兜<span class="text-[color:var(--color-accent)]">.</span>
      </h1>
      <p class="mt-7 text-lg text-[color:var(--color-fg-muted)] max-w-[620px] leading-relaxed">
        十二个分会,六种语言,一件事:把本地的 Bittensor 人定期聚起来。你的城市还没有,就开一个——品牌、playbook、预算我们出。你出"每季度办一场"的意愿。
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href="#apply" class="btn-primary inline-flex items-center gap-2 text-sm font-semibold px-6 py-3 rounded-md">现在申请<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
        <a href={L('/community/chapters')} class="btn-secondary inline-flex items-center gap-2 text-sm font-medium px-5 py-3 rounded-md">看活跃分会</a>
        <span class="ml-2 text-xs text-[color:var(--color-fg-dim)] font-mono">我们一周内回</span>
      </div>
    </div>
  </section>

  <section class="border-b hairline">
    <div class="max-w-[1200px] mx-auto px-6 py-20">
      <div class="grid lg:grid-cols-3 gap-10">

        <div>
          <div class="section-label mb-3">为什么当主理人</div>
          <h2 class="text-2xl font-semibold tracking-tight mb-6 leading-snug">三个让人点头的理由。</h2>
          <ol class="space-y-5 text-sm leading-relaxed">
            <li><span class="font-mono text-xs text-[color:var(--color-fg-dim)] mr-2">01</span><span class="text-[color:var(--color-fg)]">把本地网络聚起来</span><span class="text-[color:var(--color-fg-muted)] block mt-1">你城市里做这件事的人是散的。你成了找到他们最显然的那个地方。</span></li>
            <li><span class="font-mono text-xs text-[color:var(--color-fg-dim)] mr-2">02</span><span class="text-[color:var(--color-fg)]">第一排看新 subnet</span><span class="text-[color:var(--color-fg-muted)] block mt-1">subnet 创始人上主网之前,先来分会活动。你比别人先认识他们。</span></li>
            <li><span class="font-mono text-xs text-[color:var(--color-fg-dim)] mr-2">03</span><span class="text-[color:var(--color-fg)]">本地的品牌积累</span><span class="text-[color:var(--color-fg-muted)] block mt-1">"主理 Bittensor 东京"会一直挂在你 bio 上,只要你还在办。</span></li>
          </ol>
        </div>

        <div>
          <div class="section-label mb-3">主理人要做什么</div>
          <h2 class="text-2xl font-semibold tracking-tight mb-6 leading-snug">四件事,没一件难。</h2>
          <ul class="space-y-4 text-sm leading-relaxed">
            <li class="flex gap-3"><span class="font-mono text-xs text-[color:var(--color-accent)]">·</span><span><strong class="text-[color:var(--color-fg)]">每季度至少一场。</strong><span class="text-[color:var(--color-fg-muted)] block">Meetup、AMA、观影——你定。屋里有十二个人就算数。</span></span></li>
            <li class="flex gap-3"><span class="font-mono text-xs text-[color:var(--color-accent)]">·</span><span><strong class="text-[color:var(--color-fg)]">让一个群活着。</strong><span class="text-[color:var(--color-fg-muted)] block">Discord、Telegram、微信——你的人在哪就在哪。</span></span></li>
            <li class="flex gap-3"><span class="font-mono text-xs text-[color:var(--color-accent)]">·</span><span><strong class="text-[color:var(--color-fg)]">每场后写个回顾。</strong><span class="text-[color:var(--color-fg-muted)] block">200 字。一两张照片。我们帮你发。</span></span></li>
            <li class="flex gap-3"><span class="font-mono text-xs text-[color:var(--color-accent)]">·</span><span><strong class="text-[color:var(--color-fg)]">参加主理人同步。</strong><span class="text-[color:var(--color-fg-muted)] block">每季度一次,45 分钟,和其他主理人通话。</span></span></li>
          </ul>
        </div>

        <div>
          <div class="section-label mb-3">我们提供什么</div>
          <h2 class="text-2xl font-semibold tracking-tight mb-6 leading-snug">所有无聊的基础设施。</h2>
          <div>
            {provides.map((p) => (
              <div class="provide-row"><span class="icon">●</span><div><div class="font-medium">{p.title}</div><div class="text-[color:var(--color-fg-muted)] text-xs mt-1">{p.body}</div></div></div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="border-b hairline bg-[color:var(--color-surface)]">
    <div class="max-w-[1200px] mx-auto px-6 py-20">
      <div class="section-label mb-3">门槛</div>
      <h2 class="text-3xl md:text-4xl font-semibold tracking-tight mb-3 max-w-[640px]">四个勾选项。我们不卡专业度。</h2>
      <p class="text-[color:var(--color-fg-muted)] max-w-[640px] mb-12 leading-relaxed">你不用是 subnet owner 或 validator。你需要的是:在乎、可靠地出现、好好待人。</p>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
        {eligibility.map((e) => (
          <div class="card rounded-md p-6">
            <div class="text-2xl mb-3">●</div>
            <h4 class="font-semibold mb-2">{e.title}</h4>
            {e.bodyHtml
              ? <p class="text-sm text-[color:var(--color-fg-muted)] leading-relaxed" set:html={e.bodyHtml}></p>
              : <p class="text-sm text-[color:var(--color-fg-muted)] leading-relaxed">{e.body}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b hairline">
    <div class="max-w-[1200px] mx-auto px-6 py-20">
      <div class="section-label mb-3">从申请到第一场</div>
      <h2 class="text-3xl md:text-4xl font-semibold tracking-tight mb-12 max-w-[640px]">六步。六周。通常更短。</h2>
      <div class="grid md:grid-cols-3 gap-3">
        {steps.map((s) => (
          <div class="step"><div class="n">{s.n}</div><h4 class="font-semibold mb-1">{s.title}</h4><p class="text-sm text-[color:var(--color-fg-muted)] leading-relaxed">{s.body}</p></div>
        ))}
        <div class="step" style="border-color: rgba(184,71,11,0.3); background: rgba(184,71,11,0.04);"><div class="n" style="color: #b8470b;">06 · 第 4-8 周</div><h4 class="font-semibold mb-1">第一场活动</h4><p class="text-sm text-[color:var(--color-fg-muted)] leading-relaxed">上全球日历。你被列出来了。</p></div>
      </div>
    </div>
  </section>

  <section id="apply" class="border-b hairline scroll-mt-16">
    <div class="max-w-[1200px] mx-auto px-6 py-20">
      <div class="grid lg:grid-cols-[1fr_1.4fr] gap-12">

        <div class="lg:sticky lg:top-24 lg:self-start">
          <div class="section-label mb-3" style="color: #b8470b;">申请表</div>
          <h2 class="text-3xl md:text-4xl font-semibold tracking-tight mb-5 leading-tight">一段话。不要 deck。</h2>
          <p class="text-[color:var(--color-fg-muted)] leading-relaxed mb-6">我们不会读得比这更深——保证。诚实、具体、简短。</p>
          <ul class="text-sm text-[color:var(--color-fg-muted)] space-y-2 leading-relaxed">
            <li>· 永远不收申请费。</li>
            <li>· 提交前可以在本地存这个表单(浏览器侧)。</li>
            <li>· 如果谢绝,你会拿到一句简短的书面理由,90 天后可再申请。</li>
            <li>· 申请后没有任何义务。</li>
          </ul>
        </div>

        <form id="host-form" class="card rounded-md p-8 space-y-6" novalidate>
          <div class="grid sm:grid-cols-2 gap-5">
            <div><label class="label" for="hf-name">姓名</label><input id="hf-name" name="name" class="input" placeholder="如 Yuki Tanaka" required /></div>
            <div><label class="label" for="hf-twitter">Twitter / GitHub 账号</label><input id="hf-twitter" name="twitter" class="input" placeholder="@yourhandle" /></div>
          </div>
          <div class="grid sm:grid-cols-2 gap-5">
            <div><label class="label" for="hf-city">城市</label><input id="hf-city" name="city" class="input" placeholder="如 东京" required /></div>
            <div><label class="label" for="hf-tz">时区</label><input id="hf-tz" name="timezone" class="input" placeholder="如 JST (UTC+9)" /></div>
          </div>
          <div>
            <label class="label" for="hf-intro">简短自我介绍(100-300 字)</label>
            <textarea id="hf-intro" name="intro" class="textarea" rows="4" placeholder="你是谁、做什么、为什么 Bittensor 拽住了你。别写公司套话。" required></textarea>
          </div>
          <div>
            <label class="label" for="hf-why">为什么是这座城市,为什么是现在?</label>
            <textarea id="hf-why" name="whyThisCity" class="textarea" rows="3" placeholder="这里的氛围怎样?为什么需要一个分会?为什么是你来开?"></textarea>
          </div>
          <div>
            <label class="label" for="hf-first">你的第一场——用 2-3 句话讲讲</label>
            <textarea id="hf-first" name="firstEvent" class="textarea" rows="3" placeholder="形式、大概日期、在哪办、先邀请谁。"></textarea>
          </div>
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label class="label" for="hf-audience">现有人群</label>
              <input id="hf-audience" name="audience" class="input" placeholder="如 一个 ~80 人的微信群" />
            </div>
            <div>
              <label class="label" for="hf-cadence">你能承诺的频率</label>
              <select id="hf-cadence" name="cadence" class="input">
                <option>每季度一场</option>
                <option>每月一场</option>
                <option>每两周</option>
                <option>其它(下方说明)</option>
              </select>
            </div>
          </div>
          <label class="flex items-start gap-3 text-sm text-[color:var(--color-fg-muted)] leading-relaxed">
            <input type="checkbox" name="cocAgreed" class="mt-1" required />
            <span>我已阅读并同意 <a href="https://github.com/Cameronhq/opentao/blob/main/CODE_OF_CONDUCT.md" target="_blank" rel="noopener" class="text-[color:var(--color-fg)] underline underline-offset-2 hover:text-[color:var(--color-accent)]">行为准则</a>,并愿意至少做满 6 个月主理人。</span>
          </label>

          <div class="cf-turnstile" data-sitekey="0x4AAAAAADYu2uFOOUgAde8v" data-theme="light"></div>

          <p id="host-form-error" class="text-sm text-red-700 hidden" role="alert"></p>

          <div class="border-t hairline pt-6 flex flex-wrap items-center justify-between gap-4">
            <span class="text-xs font-mono text-[color:var(--color-fg-dim)]">以 GitHub Issue 归档 · 我们 7 天内回</span>
            <div class="flex items-center gap-3">
              <button type="submit" id="host-form-submit" class="btn-primary text-sm font-semibold px-6 py-2.5 rounded-md inline-flex items-center gap-2">提交申请<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 5l7 7-7 7"/></svg></button>
            </div>
          </div>
        </form>

        <div id="host-form-success" class="card rounded-md p-8 hidden">
          <div class="section-label mb-3" style="color: #b8470b;">收到申请</div>
          <h3 class="text-2xl font-semibold tracking-tight mb-3">收到了——谢谢。</h3>
          <p class="text-[color:var(--color-fg-muted)] leading-relaxed mb-4">已经把你的申请归档。编辑 + 两位资深主理人会在 7 天内一起读。</p>
          <p class="text-sm text-[color:var(--color-fg-muted)]">在 GitHub 上追踪:<a id="host-form-issue-link" href="#" target="_blank" rel="noopener" class="text-[color:var(--color-fg)] underline underline-offset-2 hover:text-[color:var(--color-accent)]">查看你的 issue</a>。</p>
        </div>

      </div>
    </div>
  </section>

  <section class="border-b hairline">
    <div class="max-w-[1200px] mx-auto px-6 py-16">
      <div class="grid md:grid-cols-2 gap-12">
        <div>
          <div class="section-label mb-3">FAQ</div>
          <h3 class="text-2xl font-semibold tracking-tight mb-6 leading-tight">大家会问两遍的问题。</h3>
          <div class="space-y-5">
            <details class="border-b hairline pb-4"><summary class="font-medium cursor-pointer">我得是 Bittensor 专家吗?</summary><p class="text-sm text-[color:var(--color-fg-muted)] mt-2 leading-relaxed">不用。你要的是好奇、愿意和你聚起来的人一起学。我们很多最好的主理人一开始懂得很少。</p></details>
            <details class="border-b hairline pb-4"><summary class="font-medium cursor-pointer">两个人能一起当 co-host 吗?</summary><p class="text-sm text-[color:var(--color-fg-muted)] mt-2 leading-relaxed">能——其实更鼓励。一个人签 charter 当 Lead,另一个当 Co-host。两个都列出来。</p></details>
            <details class="border-b hairline pb-4"><summary class="font-medium cursor-pointer">我的城市已经有分会了怎么办?</summary><p class="text-sm text-[color:var(--color-fg-muted)] mt-2 leading-relaxed">照样申请——我们把你接到那个分会当 co-host。一城一分会是原则。有时这意味着我们直接把你 fast-track 进现有团队。</p></details>
            <details class="border-b hairline pb-4"><summary class="font-medium cursor-pointer">报销是先给还是后给?</summary><p class="text-sm text-[color:var(--color-fg-muted)] mt-2 leading-relaxed">后给。通过主理人表单交收据,14 天内到账。大场地我们可以安排直接付给场地方。</p></details>
            <details class="border-b hairline pb-4"><summary class="font-medium cursor-pointer">如果我某个季度没办成?</summary><p class="text-sm text-[color:var(--color-fg-muted)] mt-2 leading-relaxed">漏一个季度没事,生活嘛。连漏两个我们会来问问。三个就把分会标"暂停",另找 lead。</p></details>
            <details class="pb-4"><summary class="font-medium cursor-pointer">能通过公司赞助或让公司报销吗?</summary><p class="text-sm text-[color:var(--color-fg-muted)] mt-2 leading-relaxed">本地赞助没问题,我们会在分会页放他们的 logo。可以和我们的 $500 叠加。公开声明利益关系即可。</p></details>
          </div>
        </div>

        <div>
          <div class="section-label mb-3">找个现任主理人聊聊</div>
          <h3 class="text-2xl font-semibold tracking-tight mb-6 leading-tight">听听不加滤镜的版本。</h3>
          <p class="text-[color:var(--color-fg-muted)] text-sm mb-6 leading-relaxed">没被说动?找个已经在做的人问问。他们会告诉你哪里难、哪里不难。</p>
          <div class="space-y-3">
            <a href={L('/community/chapters/tokyo')} class="card rounded-md p-4 flex items-center gap-4 block"><div class="w-10 h-10 rounded-full" style="background: linear-gradient(135deg, #b8470b, #c2410c);"></div><div class="flex-1"><div class="font-medium">Yuki Tanaka</div><div class="text-xs font-mono text-[color:var(--color-fg-dim)]">东京 · 自 2025-09</div></div><span class="text-xs text-[color:var(--color-accent)]">私信 →</span></a>
            <a href="mailto:cameron@moonshotcommons.com?subject=Talk%20to%20Ke%20Zhang%20(SF%20chapter%20host)" class="card rounded-md p-4 flex items-center gap-4 block"><div class="w-10 h-10 rounded-full" style="background: linear-gradient(135deg, #1c6ea4, #6741d9);"></div><div class="flex-1"><div class="font-medium">Ke Zhang</div><div class="text-xs font-mono text-[color:var(--color-fg-dim)]">旧金山 · 自 2025-06</div></div><span class="text-xs text-[color:var(--color-accent)]">私信 →</span></a>
            <a href="mailto:cameron@moonshotcommons.com?subject=Talk%20to%20Carlos%20Müller%20(Berlin%20chapter%20host)" class="card rounded-md p-4 flex items-center gap-4 block"><div class="w-10 h-10 rounded-full" style="background: linear-gradient(135deg, #15803d, #16a34a);"></div><div class="flex-1"><div class="font-medium">Carlos Müller</div><div class="text-xs font-mono text-[color:var(--color-fg-dim)]">柏林 · 自 2025-11</div></div><span class="text-xs text-[color:var(--color-accent)]">私信 →</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script is:inline>
  (function () {
    var API_BASE = 'https://opentao-api.cameron-530.workers.dev';
    var form = document.getElementById('host-form');
    if (!form) return;
    var errEl = document.getElementById('host-form-error');
    var submitBtn = document.getElementById('host-form-submit');
    var successEl = document.getElementById('host-form-success');
    var linkEl = document.getElementById('host-form-issue-link');

    function showError(msg) {
      if (!errEl) return;
      errEl.textContent = msg;
      errEl.classList.remove('hidden');
    }
    function clearError() {
      if (!errEl) return;
      errEl.textContent = '';
      errEl.classList.add('hidden');
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      clearError();

      var fd = new FormData(form);
      var payload = {
        name: (fd.get('name') || '').toString().trim(),
        twitter: (fd.get('twitter') || '').toString().trim(),
        city: (fd.get('city') || '').toString().trim(),
        timezone: (fd.get('timezone') || '').toString().trim(),
        intro: (fd.get('intro') || '').toString().trim(),
        whyThisCity: (fd.get('whyThisCity') || '').toString().trim(),
        firstEvent: (fd.get('firstEvent') || '').toString().trim(),
        audience: (fd.get('audience') || '').toString().trim(),
        cadence: (fd.get('cadence') || '').toString().trim(),
        cocAgreed: fd.get('cocAgreed') === 'on' || fd.get('cocAgreed') === 'true',
        turnstileToken: '',
      };

      if (!payload.name || !payload.city || !payload.intro) {
        showError('姓名、城市、自我介绍是必填的。');
        return;
      }
      if (!payload.cocAgreed) {
        showError('请勾选行为准则。');
        return;
      }

      try {
        if (typeof window.turnstile !== 'undefined' && window.turnstile.getResponse) {
          payload.turnstileToken = window.turnstile.getResponse() || '';
        }
      } catch (_e) {}
      if (!payload.turnstileToken) {
        showError('请完成人机校验。');
        return;
      }

      submitBtn.setAttribute('disabled', 'true');
      submitBtn.textContent = '提交中…';

      try {
        var res = await fetch(API_BASE + '/host-application', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        var data = await res.json().catch(function () { return {}; });
        if (!res.ok || !data.ok) {
          var msg = data && data.error ? data.error : 'submit_failed';
          if (msg === 'rate_limited') msg = '你已达到提交上限,一小时后再试。';
          else if (msg === 'spam_check_failed') msg = '人机校验失败——请刷新后重试。';
          else msg = '出了点问题(' + msg + ')。你填的内容还在,再试一次。';
          showError(msg);
          submitBtn.removeAttribute('disabled');
          submitBtn.textContent = '提交申请';
          try { window.turnstile && window.turnstile.reset(); } catch (_e) {}
          return;
        }
        if (linkEl && data.issueUrl) {
          linkEl.setAttribute('href', data.issueUrl);
          linkEl.textContent = data.issueUrl;
        }
        form.classList.add('hidden');
        if (successEl) successEl.classList.remove('hidden');
      } catch (err) {
        showError('网络错误——请重试。');
        submitBtn.removeAttribute('disabled');
        submitBtn.textContent = '提交申请';
      }
    });
  })();
</script>

