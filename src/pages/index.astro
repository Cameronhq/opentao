---
import BaseLayout from '../layouts/BaseLayout.astro';

const paths = [
  {
    href: '/beginner/wiki',
    n: '01',
    label: "I'm new to Bittensor",
    title: 'Beginner',
    blurb: 'Wiki of every core concept, a page for every subnet, and an interactive learning track.',
    cta: 'Start learning',
    icon: '<path d="M4 19V5a2 2 0 012-2h9l5 5v11a2 2 0 01-2 2H6a2 2 0 01-2-2z"/><path d="M14 3v6h6"/>',
  },
  {
    href: '/build/hackathon',
    n: '02',
    label: 'I want to build a subnet',
    title: 'Build a subnet',
    blurb:
      'Hackathon and incubator programs that take ideas from prototype to mainnet — paired with a design guide and an open idea catalog.',
    cta: 'Submit an idea',
    icon: '<path d="M12 2l9 4.5v9L12 22l-9-6.5v-9L12 2z"/><path d="M3.5 7L12 12l8.5-5M12 12v10"/>',
  },
  {
    href: '/mine/playbooks',
    n: '03',
    label: 'I want to mine',
    title: 'Start mining',
    blurb: 'A general setup guide plus a fresh, verified playbook for each of the 128 subnets.',
    cta: 'Open the playbooks',
    icon: '<path d="M3 13l4-8 5 4 5-6 4 7"/><path d="M3 21h18"/>',
  },
  {
    href: '/community/events',
    n: '04',
    label: 'I want to gather',
    title: 'Community',
    blurb: 'Events around the world, host your own chapter, and read the long-form Insights.',
    cta: "See what's happening",
    icon: '<circle cx="9" cy="9" r="3"/><circle cx="17" cy="11" r="2.5"/><path d="M3 20c0-3 3-5 6-5s6 2 6 5M14 20c0-2 2-3.5 4-3.5s4 1.5 4 3.5"/>',
  },
];

const stats = [
  { label: 'Live subnets', value: '128', caption: '+3 in last 30d' },
  { label: 'Active miners', value: '52,184', caption: 'across 128 subnets' },
  { label: 'TAO staked', value: '7.42M', unit: 'τ', caption: '~$2.1B notional' },
  { label: 'Validators', value: '1,248', caption: 'top 64 receive emission' },
];
---
<BaseLayout
  title="OpenTAO — Builder's Gateway to Bittensor"
  description="Builder's Gateway to Bittensor. Learn the concepts. Mine the subnets. Build the next one. Gather with the community."
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 dot-grid opacity-40"></div>
    <div class="hero-glow"></div>
    <div class="relative max-w-[1200px] mx-auto px-6 pt-24 pb-20">
      <div class="flex items-center gap-3 mb-6">
        <span class="section-label section-index">[ 00 / Intro ]</span>
        <span class="accent-dot"></span>
        <span class="section-label">an independent, community-built knowledge layer</span>
      </div>
      <h1 class="text-[56px] md:text-[68px] leading-[1.04] tracking-[-0.03em] font-semibold max-w-[860px]">
        Builder's Gateway<br />
        to <span class="text-[color:var(--color-fg-muted)]">Bittensor.</span>
      </h1>
      <p class="mt-8 text-lg text-[color:var(--color-fg-muted)] max-w-[620px] leading-relaxed">
        Learn the concepts. Mine the subnets. Build the next one. Gather with the community —
        from your first
        <span class="term" title="The native token of the Bittensor network">TAO</span>
        to launching a subnet on mainnet.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a href="/beginner/wiki" class="btn-primary inline-flex items-center gap-2 text-sm font-medium px-5 py-2.5 rounded-md">
          Get started
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
        <a href="/beginner/subnets" class="btn-secondary inline-flex items-center gap-2 text-sm font-medium px-5 py-2.5 rounded-md">
          Explore 128 subnets
        </a>
        <span class="ml-2 text-xs text-[color:var(--color-fg-dim)] font-mono">CC BY-SA · independent · community-built</span>
      </div>

      <div class="mt-16 grid md:grid-cols-[1.1fr_0.9fr] gap-6 items-stretch">
        <div class="code rounded-md p-5">
          <div class="flex items-center gap-1.5 mb-3">
            <span class="w-2.5 h-2.5 rounded-full" style="background: #e8e6e2;"></span>
            <span class="w-2.5 h-2.5 rounded-full" style="background: #e8e6e2;"></span>
            <span class="w-2.5 h-2.5 rounded-full" style="background: #e8e6e2;"></span>
            <span class="ml-3 text-[color:var(--color-fg-dim)] text-[11px] font-mono">$ first mining session</span>
          </div>
          <div><span class="prompt">$</span> btcli wallet new_coldkey --wallet.name miner</div>
          <div><span class="prompt">$</span> btcli wallet new_hotkey  --wallet.name miner --wallet.hotkey default</div>
          <div><span class="prompt">$</span> btcli subnet register    --netuid <span class="text-[color:var(--color-accent)]">1</span> --wallet.name miner</div>
          <div class="muted">  → registration cost: 0.4081 τ</div>
          <div class="muted">  → broadcasting…</div>
          <div class="ok">  ✓ registered on subnet 1 — hotkey 5G…7Hx</div>
          <div class="mt-2"><span class="prompt">$</span> <span class="text-[color:var(--color-fg-muted)]">cd</span> opentao/playbooks/sn1 &amp;&amp; <span class="text-[color:var(--color-fg-muted)]">make</span> mine</div>
        </div>
        <div class="card rounded-md p-6 flex flex-col justify-between">
          <div>
            <div class="section-label mb-3">From day-zero to subnet</div>
            <p class="text-[color:var(--color-fg)] leading-relaxed text-[15px]">
              OpenTAO collects every concept, every <span class="term" title="A specialized network">subnet</span>,
              and every mining playbook into one place — so a curious developer can go from "what is Bittensor?"
              to running a hotkey in an afternoon.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Who are you -->
  <section class="border-t hairline">
    <div class="max-w-[1200px] mx-auto px-6 py-24">
      <div class="rule-label mb-12">
        <div></div>
        <div class="flex items-center gap-3">
          <span class="section-label section-index">[ 01 ]</span>
          <span class="section-label">Who are you</span>
        </div>
        <div></div>
      </div>
      <h2 class="text-3xl md:text-4xl tracking-tight font-semibold max-w-[600px] mb-3">Four paths. Pick the one you arrived on.</h2>
      <p class="text-[color:var(--color-fg-muted)] max-w-[560px] mb-12">
        OpenTAO is organized by intent — not by abstract topic. The fastest way through is to tell us who you are right now.
      </p>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
        {paths.map((p) => (
          <a href={p.href} class="card card-lift rounded-md p-6 block group">
            <div class="flex items-start justify-between mb-8">
              <div class="w-10 h-10 rounded-md hairline border flex items-center justify-center text-[color:var(--color-accent)]">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" set:html={p.icon}></svg>
              </div>
              <span class="font-mono text-[11px] text-[color:var(--color-fg-dim)]">{p.n}</span>
            </div>
            <div class="section-label mb-2">{p.label}</div>
            <h3 class="text-xl font-semibold tracking-tight mb-2">{p.title}</h3>
            <p class="text-sm text-[color:var(--color-fg-muted)] leading-relaxed mb-6">{p.blurb}</p>
            <div class="flex items-center text-sm text-[color:var(--color-fg-muted)]">
              {p.cta} <span class="arrow ml-2">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- What's happening now -->
  <section class="border-t hairline">
    <div class="max-w-[1200px] mx-auto px-6 py-24">
      <div class="rule-label mb-12">
        <div></div>
        <div class="flex items-center gap-3">
          <span class="section-label section-index">[ 02 ]</span>
          <span class="section-label">What's happening now</span>
        </div>
        <div></div>
      </div>
      <div class="grid lg:grid-cols-[2fr_1fr] gap-4">
        <div class="card stripe rounded-md p-8 relative">
          <div class="flex items-start justify-between gap-4">
            <div class="max-w-[560px]">
              <div class="flex items-center gap-2 mb-4">
                <span class="accent-dot"></span><span class="section-label">Live · Hackathon S1</span>
              </div>
              <h3 class="text-3xl font-semibold tracking-tight mb-3 leading-tight">OpenTAO Hackathon · Season 1</h3>
              <p class="text-[color:var(--color-fg-muted)] leading-relaxed">$250k in prizes across four tracks — LLM, Robotics, Data, and Open. Submissions close on July 14. Top three teams move directly to the Incubator interview.</p>
              <div class="mt-6 flex items-center gap-3">
                <a href="/build/hackathon" class="btn-primary inline-flex items-center gap-2 text-sm font-medium px-4 py-2 rounded-md">
                  Submit your idea
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
                </a>
                <a href="/build/hackathon" class="text-sm text-[color:var(--color-fg-muted)] hover:text-[color:var(--color-fg)]">View tracks &amp; judges →</a>
              </div>
            </div>
            <div class="hidden md:flex flex-col items-end gap-1 font-mono text-xs text-[color:var(--color-fg-muted)]">
              <div><span class="text-[color:var(--color-fg-dim)]">opens</span> 2026·05·12</div>
              <div><span class="text-[color:var(--color-fg-dim)]">closes</span> 2026·07·14</div>
              <div><span class="text-[color:var(--color-fg-dim)]">demo</span>  2026·07·22</div>
            </div>
          </div>
        </div>
        <div class="grid grid-rows-2 gap-4">
          <div class="card rounded-md p-6">
            <div class="section-label mb-3">Next community event</div>
            <h4 class="text-lg font-semibold tracking-tight">Bittensor Tokyo Meetup #03</h4>
            <p class="text-sm text-[color:var(--color-fg-muted)] mt-1">Shibuya · June 8, 19:00 JST · hosted by Tokyo Chapter</p>
            <div class="mt-4 flex items-center justify-between">
              <a href="/community/events" class="text-sm text-[color:var(--color-accent)] hover:underline">Register on Luma →</a>
              <span class="font-mono text-[11px] text-[color:var(--color-fg-dim)]">12 days</span>
            </div>
          </div>
          <div class="card rounded-md p-6">
            <div class="section-label mb-3">Incubator · Cohort 02</div>
            <h4 class="text-lg font-semibold tracking-tight">Applications open</h4>
            <p class="text-sm text-[color:var(--color-fg-muted)] mt-1">10-week program · $50k pre-seed · mentors from 8 live subnets.</p>
            <div class="mt-4 flex items-center justify-between">
              <a href="/build/incubator" class="text-sm text-[color:var(--color-accent)] hover:underline">Apply →</a>
              <span class="font-mono text-[11px] text-[color:var(--color-fg-dim)]">closes Jun 30</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="border-t hairline">
    <div class="max-w-[1200px] mx-auto px-6 py-24">
      <div class="rule-label mb-12">
        <div></div>
        <div class="flex items-center gap-3">
          <span class="section-label section-index">[ 03 ]</span>
          <span class="section-label">Bittensor at a glance</span>
        </div>
        <div></div>
      </div>
      <div class="grid sm:grid-cols-2 md:grid-cols-4 border hairline rounded-md overflow-hidden bg-[color:var(--color-surface)]">
        {stats.map((s, i) => (
          <div class={`p-7 ${i < stats.length - 1 ? 'border-r hairline border-b sm:border-b-0' : ''}`}>
            <div class="section-label">{s.label}</div>
            <div class="stat-num text-4xl mt-3">
              {s.value}
              {s.unit && <span class="text-[color:var(--color-fg-muted)] text-lg"> {s.unit}</span>}
            </div>
            <div class="text-xs text-[color:var(--color-fg-dim)] mt-2 font-mono">{s.caption}</div>
          </div>
        ))}
      </div>
      <div class="mt-4 text-xs font-mono text-[color:var(--color-fg-dim)]">
        Data refreshed from chain · last sync 2026·05·27 14:08 UTC · methodology coming
      </div>
    </div>
  </section>

  <!-- Featured reading -->
  <section class="border-t hairline">
    <div class="max-w-[1200px] mx-auto px-6 py-24">
      <div class="rule-label mb-12">
        <div></div>
        <div class="flex items-center gap-3">
          <span class="section-label section-index">[ 04 ]</span>
          <span class="section-label">Featured reading</span>
        </div>
        <div></div>
      </div>
      <div class="grid lg:grid-cols-[2fr_1fr] gap-4">
        <div class="grid sm:grid-cols-2 gap-4">
          <a href="/community/insights/yuma-walk-through" class="card rounded-md p-6 block">
            <div class="section-label mb-4">Insight · Deep dive</div>
            <h3 class="text-lg font-semibold tracking-tight leading-snug mb-3">Yuma Consensus, slowly: a hand-traced walk through one block.</h3>
            <p class="text-sm text-[color:var(--color-fg-muted)] leading-relaxed">We pause at every variable. By the end you can predict what every validator's weight does to emission — without opening the paper.</p>
            <div class="mt-5 flex items-center justify-between text-xs text-[color:var(--color-fg-dim)] font-mono">
              <span>by @rho.lab</span><span>22 min · 2026·05·19</span>
            </div>
          </a>
          <a href="/community/insights/why-dtao-changed-everything" class="card rounded-md p-6 block">
            <div class="section-label mb-4">Insight · Retrospective</div>
            <h3 class="text-lg font-semibold tracking-tight leading-snug mb-3">Why dTAO changed everything (and three things it didn't).</h3>
            <p class="text-sm text-[color:var(--color-fg-muted)] leading-relaxed">One year in, dTAO reshaped how subnets compete for capital. Here's what the data shows.</p>
            <div class="mt-5 flex items-center justify-between text-xs text-[color:var(--color-fg-dim)] font-mono">
              <span>by @ke.ng</span><span>14 min · 2026·05·11</span>
            </div>
          </a>
          <a href="/community/insights/sn-18-interview" class="card rounded-md p-6 block sm:col-span-2">
            <div class="flex items-start gap-6">
              <div class="flex-1">
                <div class="section-label mb-3">Insight · Interview</div>
                <h3 class="text-lg font-semibold tracking-tight leading-snug mb-2">"We almost shipped a centralized API and called it a subnet." — a conversation with SN-18.</h3>
                <p class="text-sm text-[color:var(--color-fg-muted)] leading-relaxed max-w-[640px]">The founders of one of Bittensor's longest-running subnets on the temptation of shortcuts.</p>
              </div>
              <div class="hidden md:flex flex-col items-end gap-1 font-mono text-[11px] text-[color:var(--color-fg-dim)]">
                <span>by editorial</span><span>32 min</span><span>2026·05·04</span>
              </div>
            </div>
          </a>
        </div>
        <div class="card rounded-md p-6 flex flex-col">
          <div class="section-label mb-4">Subnet of the week</div>
          <div class="flex items-baseline gap-3">
            <span class="font-mono text-xs text-[color:var(--color-fg-dim)]">netuid</span>
            <span class="text-3xl font-semibold tracking-tight">42</span>
          </div>
          <h3 class="text-xl font-semibold tracking-tight mt-2">Cortex · open-ended reasoning traces</h3>
          <p class="text-sm text-[color:var(--color-fg-muted)] mt-3 leading-relaxed">Miners produce step-by-step reasoning traces graded by an ensemble of verifier models. Active community, fresh playbook.</p>
          <div class="mt-5 grid grid-cols-2 gap-x-4 gap-y-2 text-xs font-mono">
            <div class="text-[color:var(--color-fg-dim)]">category</div><div>Reasoning</div>
            <div class="text-[color:var(--color-fg-dim)]">hardware</div><div>1× A100 80G</div>
            <div class="text-[color:var(--color-fg-dim)]">playbook</div><div>✓ verified 2d ago</div>
            <div class="text-[color:var(--color-fg-dim)]">status</div><div class="text-[color:var(--color-accent)]">healthy</div>
          </div>
          <a href="/beginner/subnets/42-cortex" class="mt-auto pt-6 text-sm text-[color:var(--color-fg)] hover:text-[color:var(--color-accent)] inline-flex items-center gap-1">Read the subnet page →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Contribute strip -->
  <section class="border-t hairline">
    <div class="max-w-[1200px] mx-auto px-6 py-20">
      <div class="grid md:grid-cols-[1fr_auto] gap-8 items-center">
        <div>
          <div class="section-label mb-3">Every page is editable</div>
          <h3 class="text-2xl font-semibold tracking-tight max-w-[560px] leading-snug">
            OpenTAO is a public good. Spot a stale playbook or a missing concept? Open a PR.
          </h3>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="https://github.com/opentao-ai/opentao" target="_blank" rel="noopener" class="btn-secondary inline-flex items-center gap-2 text-sm font-medium px-4 py-2 rounded-md">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1-.02-1.96-3.2.69-3.87-1.54-3.87-1.54-.52-1.33-1.27-1.68-1.27-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.69 1.25 3.34.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.9 10.9 0 015.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.4-5.25 5.69.41.36.78 1.06.78 2.13 0 1.54-.01 2.78-.01 3.16 0 .31.21.68.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/></svg>
            Contribute on GitHub
          </a>
          <a href="https://github.com/opentao-ai/opentao/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener" class="btn-secondary inline-flex items-center gap-2 text-sm font-medium px-4 py-2 rounded-md">Read the style guide</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
