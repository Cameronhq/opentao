---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SubNav from '../../../components/SubNav.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { insights, type Insight } from '../../../data/insights';

export async function getStaticPaths() {
  // Only generate stub pages here. Rich insight pages (rich === true, e.g.
  // yuma-walk-through) live as their own .astro files and would conflict
  // with the dynamic route.
  return insights
    .filter((i) => !i.rich)
    .map((i) => ({ params: { slug: i.slug }, props: { insight: i } }));
}

interface Props { insight: Insight }
const { insight } = Astro.props;

const subnav = [
  { href: '/community/events', label: 'Events' },
  { href: '/community/chapters', label: 'Chapters' },
  { href: '/community/insights', label: 'Insights' },
];
---
<BaseLayout
  title={`${insight.title} — Insights — OpenTAO`}
  description={insight.lead}
  section="community"
>
  <SubNav items={subnav} active="/community/insights" rightMeta={`${insight.type} · ${insight.readTime}`} />

  <section class="border-b hairline">
    <div class="article px-6 pt-16 pb-12">
      <Breadcrumb crumbs={[
        { href: '/', label: 'OpenTAO' },
        { href: '/community/events', label: 'Community' },
        { href: '/community/insights', label: 'Insights' },
        { label: insight.title },
      ]} />
      <div class={`cover ${insight.cover} rounded-md mb-8`}>{insight.coverText}</div>
      <div class="flex items-center gap-3 mb-5">
        <span class="type-tag" style="color: #b8470b;">{insight.type} · {insight.readTime}</span>
        <span class="text-[color:var(--color-fg-dim)] font-mono text-xs">{insight.date}</span>
      </div>
      <h1 class="font-serif font-medium text-[44px] md:text-[52px] leading-[1.05] tracking-[-0.025em]">{insight.title}</h1>
      <p class="font-serif italic font-normal text-2xl text-[color:var(--color-fg-muted)] mt-6 leading-[1.45]">{insight.lead}</p>
      <div class="mt-10 flex items-center gap-4">
        <div class="w-8 h-8 rounded-full" style="background: linear-gradient(135deg, #6741d9, #1c6ea4);"></div>
        <div>
          <div class="text-sm text-[color:var(--color-fg)]">{insight.author}</div>
          {insight.authorHandle && <div class="text-xs font-mono text-[color:var(--color-fg-dim)]">{insight.authorHandle}</div>}
        </div>
      </div>
    </div>
  </section>

  <main class="border-b hairline">
    <article class="article px-6 py-16">
      <div class="stub-banner">
        <div class="label">Editor's note</div>
        <p class="text-sm text-[color:var(--color-fg-muted)] leading-relaxed m-0">
          The full essay is being written and edited. Below is the short version — the full {insight.readTime} treatment will land here as soon as it's reviewed. For a sense of what the finished version looks like, see <a class="inline" href="/community/insights/yuma-walk-through">Yuma consensus, slowly</a>.
        </p>
      </div>

      <h2 id="short-version"><span class="index">I.</span>The short version</h2>
      <p>{insight.body}</p>

      <h2 id="what-is-coming"><span class="index">II.</span>What's coming in the full piece</h2>
      <p>The full essay will expand the short version above with worked examples, on-chain data where relevant, and a longer take from {insight.author}. We publish one new essay every other Friday — to get notified when this one lands, subscribe from the <a class="inline" href="/community/insights">Insights index</a>.</p>
    </article>
  </main>

  <section class="border-b hairline">
    <div class="article px-6 py-10">
      <div class="flex flex-wrap items-center gap-3 text-sm">
        <a href="/community/insights" class="pill">← All insights</a>
        <a href="/community/insights/yuma-walk-through" class="pill">See a finished essay</a>
        <a href="/community/insights/contribute" class="pill">Pitch us your own →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .article { max-width: 720px; margin: 0 auto; }
  .article p { color: #1c1c22; line-height: 1.75; margin: 22px 0; font-size: 18px; }
  .article h2 { font-family: var(--font-serif); font-weight: 500; font-size: 30px; letter-spacing: -0.015em; margin: 56px 0 16px; color: #0c0c10; }
  .article h2 .index { font-family: var(--font-mono); font-size: 13px; color: #b8b8be; letter-spacing: 0.06em; vertical-align: middle; margin-right: 14px; font-weight: 400; }
  .article a.inline { color: #0c0c10; text-decoration: underline; text-decoration-color: rgba(184,71,11,0.45); text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .article a.inline:hover { text-decoration-color: #b8470b; }

  .stub-banner { background: linear-gradient(180deg, rgba(184,71,11,0.05), rgba(184,71,11,0)); border-left: 3px solid #b8470b; padding: 18px 22px; border-radius: 0 6px 6px 0; margin: 0 0 28px; }
  .stub-banner .label { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: #b8470b; margin-bottom: 6px; }

  .type-tag { font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: 0.08em; text-transform: uppercase; color: #4a4a52; }
  .cover { background: #fafaf9; border: 1px solid rgba(15,15,18,0.08); aspect-ratio: 16/8; display: flex; align-items: center; justify-content: center; color: #767680; font-family: 'JetBrains Mono', monospace; font-size: 11px; }
  .cover-1 { background: linear-gradient(135deg, #fdf3e3, #f5e8d2); color: #b8470b; }
  .cover-2 { background: linear-gradient(135deg, #e8f1f7, #d4e4f0); color: #1c6ea4; }
  .cover-3 { background: linear-gradient(135deg, #f0eafa, #e0d6f0); color: #6741d9; }
  .cover-4 { background: linear-gradient(135deg, #e6f4ea, #d2ead8); color: #15803d; }
  .cover-5 { background: linear-gradient(135deg, #fceae3, #f6d6cd); color: #c2410c; }
  .cover-6 { background: linear-gradient(135deg, #faf0d6, #f0e2bd); color: #a16207; }

  .pill { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border: 1px solid rgba(15,15,18,0.12); border-radius: 6px; font-size: 13px; color: #4a4a52; }
  .pill:hover { color: #0c0c10; border-color: rgba(15,15,18,0.28); }
</style>
