---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="404 — Page not found — OpenTAO"
  description="That page doesn't exist (yet). Try the directories below or search the whole site with ⌘K."
>
  <section class="border-b hairline">
    <div class="max-w-[900px] mx-auto px-6 pt-24 pb-24">
      <div class="flex items-center gap-3 mb-6">
        <span class="section-label section-index">[ 404 ]</span>
        <span class="accent-dot"></span>
        <span class="section-label">page not found</span>
      </div>

      <h1 class="text-[64px] md:text-[88px] leading-[1.02] tracking-[-0.03em] font-semibold">
        That page<br>
        <span class="text-[color:var(--color-fg-muted)] font-serif italic">doesn't exist yet.</span>
      </h1>

      <p class="mt-8 text-lg text-[color:var(--color-fg-muted)] max-w-[560px] leading-relaxed">
        OpenTAO is in active construction — some links land here while content
        is still being written. The fastest way to find what you need:
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-3">
        <button
          onclick="window.dispatchEvent(new KeyboardEvent('keydown',{key:'k',metaKey:true,ctrlKey:true}))"
          class="btn-primary inline-flex items-center gap-2 text-sm font-medium px-5 py-2.5 rounded-md cursor-pointer"
        >
          Search the site
          <kbd class="font-mono text-[10px] text-white/70 border border-white/30 rounded px-1.5 py-0.5">⌘K</kbd>
        </button>
        <a href="/" class="btn-secondary inline-flex items-center gap-2 text-sm font-medium px-5 py-2.5 rounded-md">
          Back to home
        </a>
      </div>

      <div class="mt-16 grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <a href="/beginner/wiki" class="card rounded-md p-5 block">
          <div class="section-label mb-2">Beginner</div>
          <div class="font-medium mb-1">Wiki & concepts</div>
          <p class="text-xs text-[color:var(--color-fg-muted)]">25 concept pages, by-cluster.</p>
        </a>
        <a href="/build/idea-bank" class="card rounded-md p-5 block">
          <div class="section-label mb-2">Build a subnet</div>
          <div class="font-medium mb-1">Idea bank</div>
          <p class="text-xs text-[color:var(--color-fg-muted)]">12 vetted directions to steal.</p>
        </a>
        <a href="/mine/playbooks" class="card rounded-md p-5 block">
          <div class="section-label mb-2">Start mining</div>
          <div class="font-medium mb-1">128 playbooks</div>
          <p class="text-xs text-[color:var(--color-fg-muted)]">One per subnet, status-tagged.</p>
        </a>
        <a href="/community/events" class="card rounded-md p-5 block">
          <div class="section-label mb-2">Community</div>
          <div class="font-medium mb-1">Events</div>
          <p class="text-xs text-[color:var(--color-fg-muted)]">Meetups, AMAs, demo days.</p>
        </a>
      </div>

      <div class="mt-12 text-xs font-mono text-[color:var(--color-fg-dim)]">
        Spotted a broken link from outside?
        <a
          href="https://github.com/Cameronhq/opentao/issues/new?title=broken+link"
          target="_blank"
          rel="noopener"
          class="hover:text-[color:var(--color-fg)] underline underline-offset-2"
        >Report it on GitHub →</a>
      </div>
    </div>
  </section>
</BaseLayout>
