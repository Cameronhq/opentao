---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubNav from '../../components/SubNav.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { setupSteps as steps } from '../../data/setup-guide';

const subnav = [
  { href: '/mine/agent', label: 'Mine with agent' },
  { href: '/mine/general-setup', label: 'General setup' },
  { href: '/mine/playbooks', label: 'Subnet playbooks' },
  { href: '/mine/resources', label: 'Resources' },
];
---
<BaseLayout
  title="General Setup — Start Mining — OpenTAO"
  description="Set up once, mine many. Eight steps every subnet playbook assumes — Python, btcli, wallet, TAO, registration, verification."
  section="mine"
>
  <SubNav items={subnav} active="/mine/general-setup" rightMeta="~30 min total · OS-aware" />

  <section class="border-b hairline">
    <div class="max-w-[1200px] mx-auto px-6 pt-12 pb-10">
      <Breadcrumb crumbs={[
        { href: '/', label: 'OpenTAO' },
        { href: '/mine/playbooks', label: 'Start mining' },
        { label: 'General setup' },
      ]} />
      <div class="flex items-end justify-between gap-6 flex-wrap">
        <div>
          <h1 class="text-[44px] leading-[1.05] tracking-[-0.025em] font-semibold">Set up once. Mine many.</h1>
          <p class="text-[color:var(--color-fg-muted)] mt-2 max-w-[600px]">Every subnet playbook assumes you've done these eight things. Run them once, save the wallet, and skip straight to whichever subnet you want to mine.</p>
        </div>
        <div class="flex items-center gap-3">
          <div class="os-tabs" id="os-tabs">
            <button class="active" data-os="macos">macOS</button>
            <button data-os="linux">Linux</button>
            <button data-os="wsl">WSL</button>
          </div>
          <span class="text-xs font-mono text-[color:var(--color-fg-dim)]">est. 30 min · fresh install</span>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b hairline">
    <div class="max-w-[900px] mx-auto px-6 py-16 space-y-6" id="setup-steps" data-os="macos">
      {steps.map((s) => (
        <div class="step" id={s.id}>
          <div class={`flex items-center justify-between ${s.bullets || s.code || s.codeByOs || s.callout ? 'mb-5' : 'mb-1'}`}>
            <div class="flex items-baseline gap-3">
              <span class="step-num">{s.n}</span>
              <h3 class="text-xl font-semibold">{s.title}</h3>
            </div>
            <span class="text-xs font-mono text-[color:var(--color-fg-dim)]">{s.time}</span>
          </div>
          <p class={`text-[color:var(--color-fg-muted)] text-sm ${s.bullets || s.code || s.codeByOs ? 'mb-5' : 'mt-3'}`}>{s.body}</p>
          {s.bullets && (
            <ul class="text-sm text-[color:var(--color-fg-muted)] space-y-1.5 ml-4 list-disc marker:text-[color:var(--color-fg-dim)]">
              {s.bullets.map((b) => <li>{b}</li>)}
            </ul>
          )}
          {s.code && (
            <div class="code-block p-4 mb-3 relative">
              <div class="absolute top-3 right-3 copy-btn">copy</div>
              {s.code.lines.map((l) => {
                if (l.kind === 'spacer') return <div class="mt-2"></div>;
                if (l.kind === 'comment') return <div><span class="comment">{l.text}</span></div>;
                if (l.kind === 'ok') return <div><span class="ok">{l.text}</span></div>;
                return <div><span class="prompt">$</span> {l.text}</div>;
              })}
            </div>
          )}
          {s.codeByOs && (Object.entries(s.codeByOs) as [keyof typeof s.codeByOs, CodeBlock][]).map(([os, block]) => (
            <div class="code-block p-4 mb-3 relative" data-os-variant={os}>
              <div class="absolute top-3 right-3 copy-btn">copy</div>
              {block.lines.map((l) => {
                if (l.kind === 'spacer') return <div class="mt-2"></div>;
                if (l.kind === 'comment') return <div><span class="comment">{l.text}</span></div>;
                if (l.kind === 'ok') return <div><span class="ok">{l.text}</span></div>;
                return <div><span class="prompt">$</span> {l.text}</div>;
              })}
            </div>
          ))}
          {s.callout && (
            <div class="callout text-sm text-[color:var(--color-fg-muted)]">
              <span class="font-mono text-xs uppercase tracking-wider" style="color: #b8470b;">{s.callout.tip}</span>
              <span set:html={s.callout.html}></span>
            </div>
          )}
          {s.seeAlso && s.seeAlso.length > 0 && (
            <div class="see-also">
              <div class="see-also-label">See also · in Resources</div>
              <div class="see-also-grid">
                {s.seeAlso.map((r) => (
                  <a href={r.href} class="see-also-card">
                    <span class="sa-label">{r.label}</span>
                    {r.meta && <span class="sa-meta">{r.meta}</span>}
                    <span class="sa-arrow">→</span>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      ))}
    </div>

    <div class="max-w-[900px] mx-auto px-6 pb-16">
      <div class="flex items-center justify-between border-t hairline pt-6 text-xs font-mono text-[color:var(--color-fg-dim)]">
        <span>Last verified 2026·05·30 against btcli 9.22.x</span>
        <a href="/mine/playbooks" class="hover:text-[color:var(--color-accent)] text-sm">After setup → pick a subnet to mine →</a>
      </div>
    </div>
  </section>

  <script>
    const stepsEl = document.getElementById('setup-steps');
    const tabsEl = document.getElementById('os-tabs');
    if (stepsEl && tabsEl) {
      tabsEl.querySelectorAll<HTMLButtonElement>('button[data-os]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const os = btn.dataset.os || 'macos';
          stepsEl.dataset.os = os;
          tabsEl.querySelectorAll('button[data-os]').forEach((b) => b.classList.toggle('active', b === btn));
        });
      });
    }

    // Copy-to-clipboard for prompt lines
    document.querySelectorAll<HTMLDivElement>('.code-block .copy-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const block = btn.parentElement;
        if (!block) return;
        const text = Array.from(block.querySelectorAll<HTMLDivElement>(':scope > div'))
          .filter((d) => !d.classList.contains('copy-btn'))
          .map((d) => {
            const prompt = d.querySelector('.prompt');
            return prompt ? d.textContent?.replace(/^\$\s*/, '').trim() : '';
          })
          .filter(Boolean)
          .join('\n');
        try {
          await navigator.clipboard.writeText(text);
          const orig = btn.textContent;
          btn.textContent = 'copied ✓';
          setTimeout(() => { btn.textContent = orig; }, 1200);
        } catch { btn.textContent = 'failed'; }
      });
    });
  </script>
</BaseLayout>

<style>
  .step {
    background: #ffffff;
    border: 1px solid rgba(15, 15, 18, 0.08);
    border-radius: 8px;
    padding: 28px;
    transition: border-color 0.15s;
  }
  .step:hover { border-color: rgba(15, 15, 18, 0.22); }
  .step-num {
    font-family: var(--font-mono);
    font-size: 13px;
    color: #767680;
  }
  .step-num.done { color: #15803d; }
  .step-num.current { color: #b8470b; }
  .code-block {
    background: #faf8f4;
    color: #0c0c10;
    border: 1px solid rgba(15, 15, 18, 0.1);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.7;
    border-radius: 5px;
  }
  .code-block .prompt { color: #b8470b; }
  .code-block .comment { color: #767680; }
  .code-block .ok { color: #15803d; }

  /* OS-variant code blocks — show only the one matching #setup-steps[data-os] */
  #setup-steps[data-os="macos"] .code-block[data-os-variant]:not([data-os-variant="macos"]) { display: none; }
  #setup-steps[data-os="linux"] .code-block[data-os-variant]:not([data-os-variant="linux"]) { display: none; }
  #setup-steps[data-os="wsl"]   .code-block[data-os-variant]:not([data-os-variant="wsl"])   { display: none; }
  .os-tabs {
    display: inline-flex;
    border: 1px solid rgba(15, 15, 18, 0.14);
    border-radius: 5px;
    padding: 2px;
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .os-tabs button {
    padding: 4px 10px;
    border-radius: 3px;
    color: #4a4a52;
    background: transparent;
    border: 0;
    font: inherit;
    cursor: pointer;
  }
  .os-tabs button.active {
    background: rgba(184, 71, 11, 0.1);
    color: #b8470b;
  }
  .callout {
    background: rgba(184, 71, 11, 0.05);
    border-left: 3px solid #b8470b;
    padding: 14px 18px;
    border-radius: 4px;
  }
  .see-also {
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px dashed rgba(15, 15, 18, 0.1);
  }
  .see-also-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #767680;
    margin-bottom: 8px;
  }
  .see-also-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 8px;
  }
  .see-also-card {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: baseline;
    gap: 10px;
    padding: 10px 14px;
    border: 1px solid rgba(15, 15, 18, 0.08);
    border-radius: 5px;
    background: #fafaf9;
    transition: all 0.12s;
  }
  .see-also-card:hover {
    border-color: rgba(184, 71, 11, 0.35);
    background: #ffffff;
  }
  .see-also-card .sa-label { font-size: 13px; color: #0c0c10; }
  .see-also-card .sa-meta { font-family: var(--font-mono); font-size: 10px; color: #767680; }
  .see-also-card .sa-arrow { color: #b8470b; font-family: var(--font-mono); }
  .copy-btn {
    color: #767680;
    font-family: var(--font-mono);
    font-size: 11px;
    cursor: pointer;
  }
  .copy-btn:hover { color: #0c0c10; }
</style>
