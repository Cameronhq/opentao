---
import { getLangFromUrl, useTranslations, localizePath, hasZh } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const link = (route: string) => localizePath(route, hasZh(route) ? lang : 'en');

const cols = [
  {
    label: t('foot.learn'),
    links: [
      { href: link('/beginner/wiki'), label: t('nav.wiki') },
      { href: link('/beginner/subnets'), label: t('nav.subnets') },
      { href: 'https://www.hackquest.io/learning-track/Bittensor', label: `${t('nav.learning')} ↗`, external: true },
    ],
  },
  {
    label: t('foot.buildmine'),
    links: [
      { href: link('/build/hackathon'), label: t('nav.hackathon') },
      { href: link('/build/incubator'), label: t('nav.incubator') },
      { href: link('/build/idea-bank'), label: t('nav.ideabank') },
      { href: link('/mine/playbooks'), label: t('nav.playbooks') },
      { href: link('/mine/resources'), label: t('nav.resources') },
    ],
  },
  {
    label: t('foot.community'),
    links: [
      { href: link('/community/events'), label: t('nav.events') },
      { href: link('/community/chapters'), label: t('nav.chapters') },
      { href: link('/community/insights'), label: t('nav.insights') },
    ],
  },
];
---
<footer class="border-t hairline">
  <div class="max-w-[1200px] mx-auto px-6 py-14">
    <div class="grid sm:grid-cols-2 md:grid-cols-5 gap-8">
      <div class="md:col-span-2">
        <div class="flex items-center gap-2">
          <img src="/opentaoai.jpeg" alt="OpenTAO" class="logo h-7 w-auto" />
        </div>
        <p class="text-sm text-[color:var(--color-fg-muted)] mt-4 max-w-[320px] leading-relaxed">
          {t('foot.tagline')}
        </p>
        <p class="text-xs text-[color:var(--color-fg-dim)] mt-4 font-mono">
          {t('foot.disclaimer')}
        </p>
      </div>
      {cols.map((c) => (
        <div>
          <div class="section-label mb-4">{c.label}</div>
          <ul class="space-y-2 text-sm text-[color:var(--color-fg-muted)]">
            {c.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="hover:text-[color:var(--color-fg)]"
                  target={l.external ? '_blank' : undefined}
                  rel={l.external ? 'noopener' : undefined}
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="mt-12 pt-6 border-t hairline flex flex-wrap items-center justify-between gap-3 text-xs font-mono text-[color:var(--color-fg-dim)]">
      <div>{t('foot.copyright')}</div>
      <div class="flex items-center gap-4">
        <a href="https://github.com/Cameronhq/opentao" class="hover:text-[color:var(--color-fg)]" target="_blank" rel="noopener">GitHub</a>
      </div>
    </div>
  </div>
</footer>
