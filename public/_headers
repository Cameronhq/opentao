# Cloudflare Workers Assets — _headers config
# Path patterns must start with `/`. Glob-style `*.ext` (allowed in legacy
# Pages) is rejected by Workers Assets — keep all rules path-rooted.

# Hot HTML — short cache so content updates surface fast on the edge
/*
  Cache-Control: public, max-age=60, s-maxage=300
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Astro fingerprinted assets — immutable for 1yr
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Pagefind index — hashed assets safe to cache forever
/pagefind/*
  Cache-Control: public, max-age=31536000, immutable

# OG cards — they only change when content changes; safe to long-cache
/og/*
  Cache-Control: public, max-age=2592000

# Logo / favicon
/opentaoai.jpeg
  Cache-Control: public, max-age=604800
